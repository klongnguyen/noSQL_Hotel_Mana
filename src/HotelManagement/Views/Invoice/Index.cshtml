@model HotelManagement.Models.Invoice
@using HotelManagement.ViewModels
@using HotelManagement.Models

@{
    ViewData["Title"] = "Hóa Đơn & Thanh Toán";
    var hotels = ViewBag.Hotels as IEnumerable<Hotel> ?? Enumerable.Empty<Hotel>();
    var selectedHotelId = ViewBag.SelectedHotelId as string ?? "HTL001";
    var selectedRoomNumber = ViewBag.SelectedRoomNumber as int?;
    var bookingIdParam = ViewBag.BookingId as string ?? Context.Request.Query["bookingId"].ToString();
    var roomInvoices = ViewBag.RoomInvoices as List<RoomInvoiceItem>;
}

<div class="container-fluid px-0">
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small mono-breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item text-secondary">Thu ngân & kế toán</li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Hóa đơn</li>
                </ol>
            </nav>
            <h2 class="h4 fw-bold text-dark mb-0">Quản Lý & Tra Cứu Hóa Đơn</h2>
        </div>
    </div>

    <!-- Khung tìm kiếm hóa đơn theo [Khách Sạn + Số Phòng] (Phương pháp tra cứu tối ưu lễ tân) -->
    <div class="mono-card mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-door-open text-dark me-2"></i>Tra Cứu Hóa Đơn Theo Khách Sạn & Số Phòng
                </h6>
                <button class="btn btn-sm btn-link text-decoration-none text-muted p-0" type="button" data-bs-toggle="collapse" data-bs-target="#guidSearchCollapse">
                    <i class="bi bi-upc-scan me-1"></i> Tìm theo mã GUID đặt phòng
                </button>
            </div>

            <!-- Form chính: Chọn Khách sạn + Số phòng -->
            <form method="get" action="/Invoice/Index" class="row g-2 align-items-end">
                <div class="col-md-5 col-lg-4">
                    <label class="form-label small fw-bold text-secondary mb-1">Chi Nhánh Khách Sạn:</label>
                    <select name="hotelId" class="form-select mono-form-control">
                        @foreach (var h in hotels)
                        {
                            <option value="@h.HotelId" selected="@(selectedHotelId == h.HotelId)">
                                @h.HotelName (@h.City)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4 col-lg-3">
                    <label class="form-label small fw-bold text-secondary mb-1">Số Phòng Cần Thanh Toán:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-secondary-subtle font-monospace">P.</span>
                        <input type="number" name="roomNumber" value="@(selectedRoomNumber.HasValue ? selectedRoomNumber.Value.ToString() : "")" class="form-control mono-form-control font-monospace" placeholder="VD: 101, 102..." min="1" required />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn mono-btn-dark fw-semibold px-4">
                        <i class="bi bi-search me-1"></i> Tra Cứu Hóa Đơn
                    </button>
                </div>
            </form>

            <!-- Form phụ: Tìm trực tiếp theo GUID (Ẩn trong Collapse) -->
            <div class="collapse mt-3 pt-3 border-top" id="guidSearchCollapse">
                <form method="get" action="/Invoice/Index" class="row g-2 align-items-center">
                    <div class="col-md-7 col-lg-6">
                        <label class="form-label small fw-bold text-secondary mb-1">Nhập mã GUID (36 ký tự):</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-secondary-subtle"><i class="bi bi-receipt text-secondary"></i></span>
                            <input type="text" name="bookingId" value="@bookingIdParam" class="form-control mono-form-control font-monospace small" placeholder="Ví dụ: e58cccdd-ef47-5e15-8f54-afe3fc8fa3cc..." />
                        </div>
                    </div>
                    <div class="col-auto align-self-end">
                        <button type="submit" class="btn btn-outline-dark fw-semibold px-3">
                            <i class="bi bi-search me-1"></i> Tìm Theo GUID
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Hiển thị thông báo lỗi (nếu có) -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-secondary border d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-circle text-dark fs-5"></i>
            <span class="text-dark">@ViewBag.ErrorMessage</span>
        </div>
    }

    <!-- DANH SÁCH CÁC HÓA ĐƠN CỦA PHÒNG (NẾU CÓ) -->
    @if (roomInvoices != null && roomInvoices.Any())
    {
        <div class="mono-card overflow-hidden mb-4">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <div class="fw-bold text-dark">
                    <i class="bi bi-list-check me-2 text-dark"></i>Lịch Sử Đặt Phòng & Hóa Đơn Của Phòng P.@selectedRoomNumber
                    <span class="mono-badge-light ms-2">@roomInvoices.Count đợt lưu trú</span>
                </div>
                <span class="text-secondary small">Nhấp "Xem & In" để hiển thị chi tiết phiếu thanh toán</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4">Mã Đặt Phòng (Booking)</th>
                            <th>Khách Hàng</th>
                            <th>Ngày Check-in</th>
                            <th>Ngày Check-out</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-4">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var inv in roomInvoices)
                        {
                            <tr class="@(inv.IsSelected ? "table-active" : "")">
                                <td class="ps-4 font-monospace small">
                                    <span class="fw-semibold text-dark">@inv.BookingId</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@inv.GuestName</div>
                                    <small class="text-muted font-monospace">@inv.GuestId</small>
                                </td>
                                <td class="text-secondary small">@inv.CheckInDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-secondary small">@inv.CheckOutDate.ToString("dd/MM/yyyy")</td>
                                <td class="fw-bold text-dark font-monospace">@inv.TotalAmount.ToString("N0") VNĐ</td>
                                <td>
                                    @if (inv.PaymentStatus.Equals("PAID", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="mono-badge-light">
                                            <i class="bi bi-check2 me-1"></i>Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="mono-badge-dark">
                                            <i class="bi bi-hourglass-split me-1"></i>Chưa thanh toán
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Index" 
                                       asp-route-hotelId="@selectedHotelId" 
                                       asp-route-roomNumber="@selectedRoomNumber" 
                                       asp-route-bookingId="@inv.BookingId" 
                                       class="btn btn-sm @(inv.IsSelected ? "mono-btn-dark" : "mono-btn-outline")">
                                        <i class="bi bi-receipt me-1"></i> Xem & In
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Khung chi tiết hóa đơn (Hotel Folio Invoice Receipt) -->
    @if (Model != null)
    {
        <div class="mono-card overflow-hidden mx-auto" style="max-width: 850px;" id="invoiceArea">
            <div class="card-header bg-black text-white p-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-buildings text-white fs-1"></i>
                    <div>
                        <h4 class="mb-0 fw-bold text-white">PHIẾU HÓA ĐƠN KHÁCH SẠN</h4>
                        <small class="text-white-50">Grand Hotel Management System &bull; Folio Receipt</small>
                    </div>
                </div>
                <div>
                    @if (Model.Status == "PAID" || Model.Status == "Paid")
                    {
                        <span class="mono-badge-light fs-6 px-3 py-2">
                            <i class="bi bi-check2 me-1"></i> ĐÃ THANH TOÁN
                        </span>
                    }
                    else
                    {
                        <span class="mono-badge-dark fs-6 px-3 py-2 border border-white">
                            <i class="bi bi-hourglass-split me-1"></i> CHƯA THANH TOÁN
                        </span>
                    }
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="row mb-4 pb-3 border-bottom">
                    <div class="col-sm-6">
                        <small class="text-uppercase text-secondary fw-semibold">Thông Tin Khách Hàng</small>
                        <div class="fs-5 fw-bold text-dark mt-1">@Model.CustomerName</div>
                        <div class="text-secondary small">Thời điểm xuất: @Model.IssueDate.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                        <small class="text-uppercase text-secondary fw-semibold">Số Hiệu Chứng Từ</small>
                        <div class="font-monospace small mt-1 text-secondary">
                            <strong>Mã Hóa Đơn:</strong> <span class="text-dark">@Model.InvoiceId</span>
                        </div>
                        <div class="font-monospace small text-secondary">
                            <strong>Mã Booking:</strong> <span class="text-dark">@Model.BookingId</span>
                        </div>
                    </div>
                </div>

                <div class="table-responsive mb-4">
                    <table class="table align-middle">
                        <thead class="table-light text-secondary text-uppercase small">
                            <tr>
                                <th>#</th>
                                <th>Hạng Mục Dịch Vụ</th>
                                <th class="text-end pe-3">Đơn Giá / Thành Tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-secondary">1</td>
                                <td>
                                    <div class="fw-semibold text-dark">Tiền Phòng Lưu Trú</div>
                                    <small class="text-secondary">Chi phí phòng theo thời gian lưu trú</small>
                                </td>
                                <td class="text-end fw-bold text-dark pe-3 font-monospace">@Model.RoomCharge.ToString("N0") VNĐ</td>
                            </tr>
                            <tr>
                                <td class="text-secondary">2</td>
                                <td>
                                    <div class="fw-semibold text-dark">Phí Dịch Vụ Khách Sạn</div>
                                    <small class="text-secondary">Phí tiện ích, dịch vụ buồng phòng</small>
                                </td>
                                <td class="text-end fw-bold text-dark pe-3 font-monospace">@Model.AdditionalFees.ToString("N0") VNĐ</td>
                            </tr>
                            <tr>
                                <td class="text-secondary">3</td>
                                <td>
                                    <div class="fw-semibold text-dark">Thuế Giá Trị Gia Tăng (VAT)</div>
                                    <small class="text-secondary">Thuế suất quy định</small>
                                </td>
                                <td class="text-end fw-bold text-dark pe-3 font-monospace">@Model.Tax.ToString("N0") VNĐ</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="row pt-3 border-top">
                    <div class="col-sm-7 text-secondary small">
                        <p class="mb-1"><i class="bi bi-shield-check text-dark me-1"></i>Hóa đơn điện tử hợp lệ được quản lý bởi Grand Hotel PMS.</p>
                        <p class="mb-0">Cảm ơn quý khách đã tin tưởng và sử dụng dịch vụ lưu trú của chúng tôi!</p>
                    </div>
                    <div class="col-sm-5 text-sm-end">
                        <div class="d-flex justify-content-between justify-content-sm-end gap-3 align-items-center">
                            <span class="fs-6 fw-bold text-secondary">TỔNG CỘNG:</span>
                            <span class="fs-4 fw-bold text-dark font-monospace">@Model.TotalAmount.ToString("N0") VNĐ</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light p-3 px-4 d-flex justify-content-between align-items-center border-top">
                <span class="text-secondary small">Grand Hotel Management System</span>
                <button type="button" class="btn mono-btn-dark fw-semibold" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> In Hóa Đơn
                </button>
            </div>
        </div>
    }
    else if (string.IsNullOrEmpty(ViewBag.ErrorMessage as string) && (roomInvoices == null || !roomInvoices.Any()))
    {
        <div class="mono-card p-5 text-center">
            <div class="text-muted">
                <i class="bi bi-door-open fs-1 d-block mb-3 text-dark"></i>
                <h5 class="fw-bold text-dark">Tra cứu hóa đơn & thanh toán</h5>
                <p class="small text-secondary mb-0">Chọn chi nhánh khách sạn và nhập số phòng để hiển thị hóa đơn thanh toán tương ứng.</p>
            </div>
        </div>
    }
</div>