@model HotelManagement.ViewModels.RoomListViewModel
@{
    ViewData["Title"] = "Quản Lý Danh Mục Phòng Nghỉ";
    var standardCount = Model.Rooms.Count(r => r.RoomType.Equals("Standard", StringComparison.OrdinalIgnoreCase));
    var deluxeCount = Model.Rooms.Count(r => r.RoomType.Equals("Deluxe", StringComparison.OrdinalIgnoreCase));
    var suiteCount = Model.Rooms.Count(r => r.RoomType.Equals("Suite", StringComparison.OrdinalIgnoreCase));
}

<div class="container-fluid px-0">
    <!-- Tiêu đề & Breadcrumb -->
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb" class="mono-breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item text-secondary">Quản lý cơ sở</li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Danh mục phòng nghỉ</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Danh Mục Phòng Nghỉ</h1>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2 flex-wrap align-items-center">
            <span class="mono-badge-dark px-3 py-2 fs-6">
                <i class="bi bi-door-open me-1"></i> Tổng số @Model.TotalRooms phòng
            </span>
        </div>
    </div>

    <!-- Thanh Chọn Chi Nhánh Khách Sạn -->
    <div class="mono-card p-3 p-md-4 mb-4">
        <form method="get" asp-controller="Rooms" asp-action="Index" id="roomFilterForm" class="row g-3 align-items-end">
            <!-- Chọn Khách sạn -->
            <div class="col-md-6 col-lg-5">
                <label class="form-label small fw-bold text-secondary mb-1">
                    <i class="bi bi-building text-dark me-1"></i> Chi Nhánh Khách Sạn:
                </label>
                <select name="hotelId" class="form-select mono-form-control">
                    @foreach (var h in Model.AvailableHotels)
                    {
                        <option value="@h.HotelId" selected="@(Model.SelectedHotelId == h.HotelId)">
                            @h.HotelName — (@h.City)
                        </option>
                    }
                </select>
            </div>

            <!-- Nút Xác Nhận -->
            <div class="col-md-3 col-lg-2">
                <button type="submit" class="btn mono-btn-dark w-100 fw-semibold text-nowrap">
                    <i class="bi bi-search me-1"></i> Xem Phòng
                </button>
            </div>

            <!-- Khung thông tin khách sạn đang chọn -->
            <div class="col-md-12 col-lg-5 text-lg-end">
                @if (Model.CurrentHotel != null)
                {
                    <div class="d-inline-block text-start p-2 px-3 bg-light rounded-3 border small">
                        <div class="fw-bold text-dark">
                            @Model.CurrentHotel.HotelName 
                            <span class="mono-badge-dark ms-1">@Model.CurrentHotel.StarRating ★</span>
                        </div>
                        <span class="text-secondary">
                            <i class="bi bi-geo-alt text-secondary me-1"></i>@Model.CurrentHotel.Address, @Model.CurrentHotel.City
                        </span>
                        <span class="ms-2 text-muted">| Hotline: @Model.CurrentHotel.Phone</span>
                    </div>
                }
            </div>
        </form>
    </div>

    <!-- Hàng Thẻ Thống Kê Hạng Phòng (Room Type Catalog Widgets) -->
    <div class="row g-3 mb-4">
        <!-- Tổng phòng -->
        <div class="col-6 col-md-3">
            <div class="mono-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem;">Tổng Số Phòng</small>
                        <h3 class="fw-bold mb-0 text-dark mt-1">@Model.TotalRooms</h3>
                        <span class="small text-muted">Cơ sở vật chất</span>
                    </div>
                    <div class="mono-stat-icon"><i class="bi bi-buildings"></i></div>
                </div>
            </div>
        </div>

        <!-- Phòng Standard -->
        <div class="col-6 col-md-3">
            <div class="mono-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem;">Phòng Standard</small>
                        <h3 class="fw-bold mb-0 text-dark mt-1">@standardCount</h3>
                        <span class="small text-muted">Tiêu chuẩn</span>
                    </div>
                    <div class="mono-stat-icon"><i class="bi bi-door-open"></i></div>
                </div>
            </div>
        </div>

        <!-- Phòng Deluxe -->
        <div class="col-6 col-md-3">
            <div class="mono-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem;">Phòng Deluxe</small>
                        <h3 class="fw-bold mb-0 text-dark mt-1">@deluxeCount</h3>
                        <span class="small text-muted">Cao cấp</span>
                    </div>
                    <div class="mono-stat-icon"><i class="bi bi-gem"></i></div>
                </div>
            </div>
        </div>

        <!-- Phòng Suite -->
        <div class="col-6 col-md-3">
            <div class="mono-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem;">Phòng Suite</small>
                        <h3 class="fw-bold mb-0 text-dark mt-1">@suiteCount</h3>
                        <span class="small text-muted">Thương gia</span>
                    </div>
                    <div class="mono-stat-icon"><i class="bi bi-stars"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng Quản Trị Danh Sách Phòng -->
    <div class="mono-card overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-door-open fs-5 text-dark"></i>
                <div class="fw-bold text-dark">
                    Danh Sách Buồng Phòng: 
                    <span class="text-dark fw-bold">@(Model.CurrentHotel?.HotelName ?? Model.SelectedHotelId)</span>
                </div>
            </div>
            <span class="mono-badge-light">Tổng cộng: @Model.FilteredCount phòng</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase fw-semibold">
                    <tr>
                        <th style="width: 60px;" class="text-center">#</th>
                        <th style="width: 140px;">Số Phòng</th>
                        <th>Hạng Phòng</th>
                        <th style="width: 220px;">Đơn Giá Mỗi Đêm</th>
                        <th style="width: 220px;" class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model.Rooms.Any())
                    {
                        int stt = 1;
                        foreach (var room in Model.Rooms)
                        {
                            <tr>
                                <td class="text-center text-muted small">@stt</td>
                                <td>
                                    <span class="mono-badge-dark font-monospace fs-6 px-3 py-1">
                                        P.@room.RoomNumber
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">
                                        @room.RoomType
                                    </div>
                                    <small class="text-muted font-monospace">@room.HotelId</small>
                                </td>
                                <td>
                                    <strong class="text-dark fs-6">@room.PriceFormatted</strong>
                                    <small class="text-muted d-block" style="font-size: 0.72rem;">/ đêm</small>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Bookings" asp-action="Create" 
                                           asp-route-hotelId="@room.HotelId" asp-route-roomNumber="@room.RoomNumber" 
                                           class="mono-btn-dark btn-sm" title="Đặt phòng này">
                                            <i class="bi bi-calendar-plus me-1"></i> Đặt Phòng
                                        </a>
                                        <a asp-controller="Invoice" asp-action="Index" 
                                           asp-route-hotelId="@room.HotelId" asp-route-roomNumber="@room.RoomNumber" 
                                           class="mono-btn-outline btn-sm" title="Tra cứu hóa đơn phòng">
                                            <i class="bi bi-receipt me-1"></i> Hóa Đơn
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-door-closed fs-1 d-block mb-2 text-secondary"></i>
                                    <h6 class="fw-bold text-dark">Chưa có dữ liệu phòng cho khách sạn này</h6>
                                    <p class="small text-secondary mb-3">Vui lòng chọn chi nhánh khách sạn khác.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer thống kê -->
        <div class="card-footer bg-white py-3 px-4 border-top text-muted small d-md-flex justify-content-between align-items-center">
            <span>Hiển thị toàn bộ <strong>@Model.FilteredCount</strong> phòng tại cơ sở này. Lễ tân có thể chọn ngày nhận phòng chi tiết tại bước Đặt Phòng.</span>
            <span>Grand Hotel Management System</span>
        </div>
    </div>
</div>
