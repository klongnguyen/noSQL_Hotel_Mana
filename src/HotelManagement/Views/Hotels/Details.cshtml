@model HotelManagement.Models.Hotel
@{
    ViewData["Title"] = $"Chi tiết - {Model.HotelName}";
}

<div class="container py-4">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb py-2 px-3 bg-light rounded-3 shadow-none">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Hotels" asp-action="Index" class="text-decoration-none">Khách sạn</a></li>
            <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">@Model.HotelName</li>
        </ol>
    </nav>

    <!-- Header chi tiết khách sạn -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="p-4 p-md-5 text-white" style="background: linear-gradient(135deg, #1f4037 0%, #99f2c8 100%);">
            <div class="d-md-flex justify-content-between align-items-center">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-dark px-3 py-2 rounded-pill font-monospace">
                            ID: @Model.HotelId
                        </span>
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                            @Model.StarRating ★ Tiêu chuẩn @Model.StarRating sao
                        </span>
                    </div>
                    <h1 class="display-6 fw-bold mb-2 text-dark">@Model.HotelName</h1>
                    <p class="mb-0 text-dark opacity-75 fs-5">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Address, <strong>@Model.City</strong>
                    </p>
                </div>
                <div class="mt-3 mt-md-0 text-md-end">
                    <span class="text-warning fs-3 d-block">@Model.StarDisplay</span>
                    <span class="badge bg-white text-dark shadow-sm px-3 py-2 rounded-pill">
                        Hotline: @Model.Phone
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Nội dung chính 2 cột -->
    <div class="row g-4">
        <!-- Cột trái: Thông tin & Tiện ích -->
        <div class="col-lg-8">
            <!-- Thông tin tổng quan -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="bi bi-info-circle text-primary me-2"></i>Thông tin Khách sạn
                    </h5>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <small class="text-secondary d-block">Mã định danh (hotel_id):</small>
                            <span class="fw-semibold text-dark font-monospace">@Model.HotelId</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-secondary d-block">Thành phố:</small>
                            <span class="fw-semibold text-dark">@Model.City</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-secondary d-block">Địa chỉ:</small>
                            <span class="fw-semibold text-dark">@Model.Address</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-secondary d-block">Số điện thoại:</small>
                            <span class="fw-semibold text-dark">
                                <a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danh sách tiện ích dịch vụ -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="bi bi-stars text-warning me-2"></i>Tiện ích Nổi bật
                    </h5>
                    <div class="row g-3">
                        <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                            <span class="fs-4">📶</span>
                            <span>Wifi tốc độ cao</span>
                        </div>
                        <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                            <span class="fs-4">🏊‍♂️</span>
                            <span>Hồ bơi ngoài trời</span>
                        </div>
                        <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                            <span class="fs-4">🍳</span>
                            <span>Buffet sáng miễn phí</span>
                        </div>
                        <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                            <span class="fs-4">🛎️</span>
                            <span>Lễ tân hỗ trợ 24/7</span>
                        </div>
                        <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                            <span class="fs-4">🚗</span>
                            <span>Bãi đỗ xe an toàn</span>
                        </div>
                        <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                            <span class="fs-4">❄️</span>
                            <span>Điều hòa không khí</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quy định & Chính sách -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                        <i class="bi bi-shield-check text-success me-2"></i>Chính sách Nhận & Trả phòng
                    </h5>
                    <ul class="list-unstyled mb-0 text-secondary">
                        <li class="mb-2">🕒 <strong>Nhận phòng:</strong> từ 14:00 mỗi ngày.</li>
                        <li class="mb-2">🕚 <strong>Trả phòng:</strong> trước 12:00 trưa.</li>
                        <li>💳 <strong>Hủy phòng:</strong> Hỗ trợ hoàn hủy phòng miễn phí trước ngày nhận phòng ít nhất 24 giờ.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thao tác & Thông số NoSQL -->
        <div class="col-lg-4">
            <!-- Thẻ Điều hướng hành động -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-primary text-white p-3 border-0">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-lightning-charge me-1"></i>Thao tác Nghiệp vụ
                    </h6>
                </div>
                <div class="card-body p-4">
                    <p class="text-secondary small mb-3">
                        Xem tình trạng phòng trống hoặc thực hiện đặt phòng nhanh tại khách sạn <strong>@Model.HotelName</strong>:
                    </p>

                    <div class="d-grid gap-2">
                        <!-- Chuyển sang Module Room (Story 104) -->
                        <a asp-controller="Rooms" asp-action="Index" asp-route-hotelId="@Model.HotelId" 
                           class="btn btn-primary rounded-3 py-2 fw-semibold shadow-sm">
                            Xem danh sách phòng
                        </a>

                        <!-- Chuyển sang Module Booking (Story 202) -->
                        <a asp-controller="Bookings" asp-action="Create" asp-route-hotelId="@Model.HotelId" 
                           class="btn btn-success rounded-3 py-2 fw-semibold shadow-sm">
                            Đặt phòng ngay
                        </a>

                        <hr class="my-2" />

                        <a asp-controller="Hotels" asp-action="Index" class="btn btn-outline-secondary rounded-3 py-2">
                            Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>

            <!-- Thẻ Thông số kỹ thuật NoSQL (Phục vụ Demo & Báo cáo) -->
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-database-check text-info me-1"></i>Kiến trúc NoSQL
                    </h6>
                    <small class="text-secondary d-block mb-2">
                        Chi tiết khách sạn được truy vấn theo Partition Key:
                    </small>
                    <code class="d-block p-2 bg-dark text-white rounded-3 small font-monospace">
                        SELECT * FROM hotels WHERE hotel_id = '@Model.HotelId';
                    </code>
                    <div class="mt-2 text-muted small">
                        <i class="bi bi-check-circle-fill text-success me-1"></i>
                        Single Partition Read (O(1) Latency).
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
