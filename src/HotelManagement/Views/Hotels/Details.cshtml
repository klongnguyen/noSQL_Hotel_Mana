@model HotelManagement.Models.Hotel
@{
    ViewData["Title"] = $"Hồ sơ khách sạn - {Model.HotelName}";
}

<div class="container-fluid px-0">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Hotels" asp-action="Index" class="text-decoration-none">Khách sạn</a></li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Hồ sơ @Model.HotelId</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <h2 class="h3 fw-bold text-dark mb-0">@Model.HotelName</h2>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                    Hoạt động
                </span>
            </div>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Rooms" asp-action="Index" asp-route-hotelId="@Model.HotelId" class="btn btn-success btn-sm fw-semibold shadow-xs">
                <i class="bi bi-door-open me-1"></i> Quản Lý Phòng (M3)
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <!-- Layout 2 cột Admin Inspector -->
    <div class="row g-4">
        <!-- Cột trái: Thông tin quản trị -->
        <div class="col-lg-8">
            <!-- Thẻ Thông tin chung -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-building-gear me-2 text-primary"></i>Thông Tin Cơ Sở Lưu Trú
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Mã định danh (hotel_id):</label>
                            <span class="font-monospace fw-bold text-dark fs-6">@Model.HotelId</span>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Tiêu chuẩn phân hạng:</label>
                            <span class="badge bg-warning-subtle text-warning-emphasis fw-bold px-2 py-1">
                                @Model.StarRating ★ (@Model.StarDisplay)
                            </span>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Thành phố / Tỉnh:</label>
                            <span class="fw-semibold text-dark">
                                <i class="bi bi-geo-alt text-danger me-1"></i>@Model.City
                            </span>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Số điện thoại liên hệ:</label>
                            <span class="font-monospace fw-semibold text-dark">
                                <a href="tel:@Model.Phone" class="text-decoration-none">@Model.Phone</a>
                            </span>
                        </div>
                        <div class="col-12">
                            <label class="text-muted small d-block">Địa chỉ đầy đủ:</label>
                            <span class="text-dark">@Model.Address</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ Chính sách vận hành -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-clock-history me-2 text-primary"></i>Quy Định Vận Hành & Khung Giờ
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3 text-secondary small">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <strong class="text-dark d-block mb-1">🕒 Giờ Check-in:</strong>
                                <span>Từ 14:00 mỗi ngày</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <strong class="text-dark d-block mb-1">🕚 Giờ Check-out:</strong>
                                <span>Trước 12:00 trưa</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <strong class="text-dark d-block mb-1">💳 Chính sách Hủy:</strong>
                                <span>Hỗ trợ trước 24h</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông số Kỹ thuật Cassandra NoSQL -->
        <div class="col-lg-4">
            <!-- Thông số CSDL Cassandra -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
                <div class="card-header bg-transparent py-3 px-4 border-bottom">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-database me-2 text-info"></i>Kiến Trúc Cassandra NoSQL
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Truy vấn chi tiết (Single Partition Read):</small>
                        <code class="d-block p-2 bg-dark text-light rounded-2 small font-monospace">
                            SELECT * FROM hotels<br />WHERE hotel_id = '@Model.HotelId';
                        </code>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Bảng denormalized theo Thành phố:</small>
                        <code class="d-block p-2 bg-dark text-light rounded-2 small font-monospace">
                            SELECT * FROM hotels_by_city<br />WHERE city = '@Model.City';
                        </code>
                    </div>

                    <ul class="list-unstyled mb-0 small text-secondary">
                        <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> Partition Key duy nhất: <code>hotel_id</code></li>
                        <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> Độ trễ đọc: O(1)</li>
                        <li><i class="bi bi-check2 text-success me-1"></i> Không dùng ALLOW FILTERING</li>
                    </ul>
                </div>
            </div>

            <!-- Bảng Điều Hướng Nghiệp Vụ -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-signpost me-2 text-primary"></i>Liên Kết Module Tiếp Theo
                    </h6>
                </div>
                <div class="card-body p-4 d-grid gap-2">
                    <a asp-controller="Rooms" asp-action="Index" asp-route-hotelId="@Model.HotelId" 
                       class="btn btn-outline-primary btn-sm text-start py-2">
                        <i class="bi bi-door-open me-2"></i> Danh sách phòng thuộc khách sạn (M3)
                    </a>
                    <a asp-controller="BookingQueries" asp-action="Index" asp-route-hotelId="@Model.HotelId" 
                       class="btn btn-outline-secondary btn-sm text-start py-2">
                        <i class="bi bi-calendar-range me-2"></i> Tra cứu booking theo ngày (M6)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
