@model HotelManagement.Models.Hotel
@{
    ViewData["Title"] = $"Hồ sơ khách sạn - {Model.HotelName}";
}

<div class="container-fluid px-0">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb" class="mono-breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Hotels" asp-action="Index">Khách sạn</a></li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@Model.HotelName</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <h1 class="h3 fw-bold text-dark mb-0">@Model.HotelName</h1>
                <span class="mono-badge-dark">
                    Đang hoạt động
                </span>
            </div>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Rooms" asp-action="Index" asp-route-hotelId="@Model.HotelId" class="mono-btn-dark btn-sm">
                <i class="bi bi-door-open me-1"></i> Sơ Đồ Phòng Nghỉ
            </a>
            <a asp-action="Index" class="mono-btn-outline btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <!-- Layout 2 cột Thông tin chi nhánh -->
    <div class="row g-4">
        <!-- Cột trái: Thông tin quản trị -->
        <div class="col-lg-8">
            <!-- Thẻ Thông tin chung -->
            <div class="mono-card mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-building-gear me-2 text-dark"></i>Thông Tin Cơ Sở Lưu Trú
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Mã khách sạn:</label>
                            <span class="font-monospace fw-bold text-dark fs-6">@Model.HotelId</span>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Tiêu chuẩn phân hạng:</label>
                            <span class="mono-badge-dark">
                                @Model.StarRating ★ (@Model.StarDisplay)
                            </span>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Thành phố / Tỉnh:</label>
                            <span class="fw-semibold text-dark">
                                <i class="bi bi-geo-alt text-secondary me-1"></i>@Model.City
                            </span>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Số điện thoại liên hệ:</label>
                            <span class="font-monospace fw-semibold text-dark">
                                <a href="tel:@Model.Phone" class="text-decoration-none text-dark">@Model.Phone</a>
                            </span>
                        </div>
                        <div class="col-12">
                            <label class="text-muted small d-block">Địa chỉ đầy đủ:</label>
                            <span class="text-dark">@Model.Address</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ Loại phòng nổi bật của khách sạn -->
            <div class="mono-card mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-door-open me-2 text-dark"></i>Hạng Phòng Tiêu Biểu (@(ViewBag.TotalRooms ?? 0) phòng)
                    </h6>
                    <a asp-controller="Rooms" asp-action="Index" asp-route-hotelId="@Model.HotelId" class="mono-btn-outline btn-sm">
                        Xem tất cả phòng &rarr;
                    </a>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.FeaturedRooms is IEnumerable<HotelManagement.Models.Room> rooms && rooms.Any())
                    {
                        <div class="row g-3">
                            @foreach (var rm in rooms)
                            {
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="mono-badge-dark font-monospace mb-1 d-inline-block">P.@rm.RoomNumber</span>
                                            <div class="fw-bold text-dark">@rm.RoomType</div>
                                            <small class="text-secondary fw-semibold">@rm.PriceFormatted / đêm</small>
                                        </div>
                                        <a asp-controller="Rooms" asp-action="Index" asp-route-hotelId="@Model.HotelId" asp-route-status="@rm.Status" 
                                           class="text-decoration-none">
                                            @if (rm.Status == "AVAILABLE")
                                            {
                                                <span class="mono-badge-dark">Trống</span>
                                            }
                                            else if (rm.Status == "OCCUPIED")
                                            {
                                                <span class="mono-badge-secondary">Có khách</span>
                                            }
                                            else
                                            {
                                                <span class="mono-badge-light">Bảo trì</span>
                                            }
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-door-closed fs-2 d-block mb-1 text-secondary"></i>
                            Chưa có dữ liệu phòng trực thuộc chi nhánh này.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cột phải: Thao tác & liên kết quản trị nhanh -->
        <div class="col-lg-4">
            <!-- Thẻ tác vụ nhanh -->
            <div class="mono-card mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-lightning me-2 text-dark"></i>Thao Tác Quản Trị
                    </h6>
                </div>
                <div class="card-body p-4 d-grid gap-2">
                    <a asp-controller="Rooms" asp-action="Index" asp-route-hotelId="@Model.HotelId" 
                       class="mono-btn-dark justify-content-center">
                        <i class="bi bi-grid-3x3-gap"></i> Xem Sơ Đồ Toàn Bộ Buồng Phòng
                    </a>
                    <a asp-controller="Hotels" asp-action="Index" asp-route-city="@Model.City" 
                       class="mono-btn-outline justify-content-center">
                        <i class="bi bi-geo-alt"></i> Khách Sạn Cùng Thành Phố (@Model.City)
                    </a>
                    <a asp-controller="Bookings" asp-action="Create" 
                       class="mono-btn-outline justify-content-center">
                        <i class="bi bi-calendar-plus"></i> Đặt Phòng Tại Cơ Sở Này
                    </a>
                </div>
            </div>

            <!-- Thẻ hỗ trợ kỹ thuật vận hành -->
            <div class="mono-card">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-shield-check me-2 text-dark"></i>Thông Tin Hệ Thống
                    </h6>
                </div>
                <div class="card-body p-4 small text-secondary">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Trạng thái CSDL:</span>
                        <strong class="text-dark">Astra DB Connected</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Phân vùng Keyspace:</span>
                        <span class="font-monospace text-dark">hotel_ks</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span>Chuẩn kiến trúc:</span>
                        <span class="text-dark">Query-First Partition</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
