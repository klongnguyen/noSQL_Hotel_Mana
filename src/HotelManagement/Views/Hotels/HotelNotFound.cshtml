@{
    ViewData["Title"] = "Không tìm thấy khách sạn";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="mono-card p-5">
                <div class="display-3 text-dark mb-3"><i class="bi bi-search"></i></div>
                <h2 class="fw-bold text-dark">Không tìm thấy khách sạn</h2>
                <p class="text-secondary mb-4">
                    Khách sạn với mã định danh <strong class="text-dark font-monospace">@ViewBag.HotelId</strong> không tồn tại trong hệ thống hoặc đã bị xóa.
                </p>
                <div>
                    <a asp-action="Index" class="mono-btn-dark px-4 py-2">
                        Quay về danh sách khách sạn
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
