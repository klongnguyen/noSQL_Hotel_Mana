@model IEnumerable<HotelManagement.Models.BookingHistory>

@{
    ViewData["Title"] = "Tra Cứu Lịch Sử Lưu Trú";
    var customerId = (ViewBag.CustomerId as string ?? Context.Request.Query["customerId"].ToString()).Trim();
}

<div class="container-fluid px-0">
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small mono-breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item text-secondary">Lễ tân & lưu trú</li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Lịch sử lưu trú</li>
                </ol>
            </nav>
            <h2 class="h4 fw-bold text-dark mb-0">Tra Cứu Lịch Sử Lưu Trú Của Khách Hàng</h2>
        </div>
    </div>

    <!-- Hiển thị thông báo lỗi nếu có -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger border d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
            <span class="text-dark">@ViewBag.ErrorMessage</span>
        </div>
    }

    <!-- Khung tra cứu lịch sử -->
    <div class="mono-card mb-4">
        <div class="card-body p-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-search text-dark me-2"></i>Tìm Kiếm Hồ Sơ Lưu Trú</h6>
            <form method="get" action="/BookingHistory/Index" class="row g-2 align-items-center">
                <div class="col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-secondary-subtle"><i class="bi bi-person text-secondary"></i></span>
                        <input type="text" id="customerId" name="customerId" value="@customerId" class="form-control mono-form-control" placeholder="Nhập Mã Khách Hàng (Ví dụ: GUEST001, GUEST002...)" required />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn mono-btn-dark fw-semibold px-4">
                        <i class="bi bi-search me-1"></i> Tra Cứu Lịch Sử
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Hiển thị kết quả -->
    @if (Model != null && Model.Any())
    {
        <div class="mono-card overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <div class="fw-bold text-dark">
                    <i class="bi bi-clock-history me-2 text-dark"></i>Lịch Sử Đặt Phòng Của Khách: 
                    <span class="mono-badge-dark font-monospace px-2 py-1 ms-1">@customerId</span>
                </div>
                <span class="mono-badge-light">@Model.Count() lượt lưu trú</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4">Mã Booking</th>
                            <th>Chi Nhánh Khách Sạn</th>
                            <th>Ngày Check-in</th>
                            <th>Ngày Check-out</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-4">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="font-monospace small fw-bold text-dark ps-4">@item.BookingId</td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.HotelName</div>
                                    <small class="text-secondary font-monospace">@item.HotelId</small>
                                </td>
                                <td class="text-secondary">@item.CheckInDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-secondary">@item.CheckOutDate.ToString("dd/MM/yyyy")</td>
                                <td class="fw-bold text-dark font-monospace">@item.TotalAmount.ToString("N0") VNĐ</td>
                                <td>
                                    @if (item.Status == "CONFIRMED" || item.Status == "COMPLETED" || item.Status == "OCCUPIED")
                                    {
                                        <span class="mono-badge-dark px-2 py-1">
                                            <i class="bi bi-check2 me-1"></i>@item.Status
                                        </span>
                                    }
                                    else if (item.Status == "CANCELLED")
                                    {
                                        <span class="mono-badge-secondary px-2 py-1">
                                            Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="mono-badge-light px-2 py-1">
                                            @item.Status
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-controller="Invoice" asp-action="Index" asp-route-bookingId="@item.BookingId" class="btn btn-sm mono-btn-dark py-1 px-2" title="Xem & In Hóa Đơn">
                                        <i class="bi bi-receipt me-1"></i> Hóa Đơn
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(customerId))
    {
        <div class="mono-card p-5 text-center">
            <div class="text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                <h5 class="fw-bold text-dark">Không tìm thấy lịch sử lưu trú</h5>
                <p class="small text-secondary mb-0">Khách hàng <strong>@customerId</strong> chưa có lượt đặt phòng nào trong hệ thống.</p>
            </div>
        </div>
    }
    else
    {
        <div class="mono-card p-5 text-center">
            <div class="text-muted">
                <i class="bi bi-person-lines-fill fs-1 d-block mb-3 text-dark"></i>
                <h5 class="fw-bold text-dark">Tra cứu lịch sử đặt phòng của khách hàng</h5>
                <p class="small text-secondary mb-0">Nhập mã định danh khách hàng (Ví dụ: GUEST001, GUEST002...) để xem lịch sử lưu trú.</p>
            </div>
        </div>
    }
</div>