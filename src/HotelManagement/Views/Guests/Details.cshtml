@model HotelManagement.Models.Guest
@{ ViewData["Title"] = "Chi tiết khách hàng"; }
<div class="container" style="max-width:800px">
    <h2 class="mb-4">Chi tiết khách hàng</h2>
    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Mã khách hàng</dt><dd class="col-sm-8">@Model.GuestId</dd>
                <dt class="col-sm-4">Họ tên</dt><dd class="col-sm-8">@Model.FullName</dd>
                <dt class="col-sm-4">Số điện thoại</dt><dd class="col-sm-8">@Model.Phone</dd>
                <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                <dt class="col-sm-4">CCCD/CMND</dt><dd class="col-sm-8">@Model.NationalId</dd>
            </dl>
        </div>
    </div>
    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.GuestId" class="btn btn-warning">Sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>
