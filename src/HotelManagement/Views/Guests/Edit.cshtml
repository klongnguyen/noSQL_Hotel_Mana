@model HotelManagement.Models.Guest
@{ 
    ViewData["Title"] = "Chỉnh Sửa Khách Hàng"; 
}

<div class="container" style="max-width:750px">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small mono-breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Guests" asp-action="Index">Khách hàng</a></li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Chỉnh sửa</li>
                </ol>
            </nav>
            <h2 class="h4 fw-bold text-dark mb-0">Chỉnh Sửa Hồ Sơ Khách Hàng</h2>
        </div>
        <a asp-action="Index" class="btn mono-btn-outline btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.GuestId" method="post" class="mono-card overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-pencil-square text-dark me-2"></i>Cập Nhật Thông Tin Khách Hàng</h6>
        </div>
        <div class="card-body p-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger border small mb-4"></div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="GuestId" class="form-label fw-semibold small text-uppercase text-secondary">Mã Khách Hàng (Cố định)</label>
                    <input asp-for="GuestId" class="form-control mono-form-control bg-light font-monospace text-muted" readonly />
                    <span asp-validation-for="GuestId" class="text-danger small d-block mt-1"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold small text-uppercase text-secondary">
                        Họ Và Tên <span class="text-danger">*</span>
                    </label>
                    <input asp-for="FullName" class="form-control mono-form-control" required minlength="2" maxlength="100" />
                    <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-semibold small text-uppercase text-secondary">
                        Số Điện Thoại <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Phone" class="form-control mono-form-control font-monospace" required pattern="0\d{9}" maxlength="10" title="Số điện thoại phải gồm đúng 10 chữ số và bắt đầu bằng số 0" />
                    <span asp-validation-for="Phone" class="text-danger small d-block mt-1"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold small text-uppercase text-secondary">
                        Địa Chỉ Email <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Email" type="email" class="form-control mono-form-control" required />
                    <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                </div>
                <div class="col-12">
                    <label asp-for="NationalId" class="form-label fw-semibold small text-uppercase text-secondary">
                        Số Căn Cước Công Dân (CCCD 12 Chữ Số) <span class="text-danger">*</span>
                    </label>
                    <input asp-for="NationalId" class="form-control mono-form-control font-monospace" required pattern="\d{12}" maxlength="12" minlength="12" title="Căn cước công dân phải gồm đúng 12 chữ số" />
                    <span asp-validation-for="NationalId" class="text-danger small d-block mt-1"></span>
                </div>
            </div>
        </div>
        <div class="card-footer bg-white p-3 px-4 border-top d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn mono-btn-outline px-4">Hủy</a>
            <button type="submit" class="btn mono-btn-dark px-4 fw-semibold">
                <i class="bi bi-check2 me-1"></i> Cập Nhật
            </button>
        </div>
    </form>
</div>
