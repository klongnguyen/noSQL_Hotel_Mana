@model HotelManagement.Models.Guest
@{ 
    ViewData["Title"] = "Xác Nhận Xóa Khách Hàng"; 
}

<div class="container" style="max-width:700px">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Guests" asp-action="Index" class="text-decoration-none">Khách hàng</a></li>
                    <li class="breadcrumb-item active text-danger fw-semibold" aria-current="page">Xóa hồ sơ</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold text-danger mb-0">Xác Nhận Xóa Khách Hàng</h2>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-header bg-danger bg-opacity-10 text-danger py-3 px-4 border-bottom">
            <h6 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Cảnh Báo Thao Tác Xóa</h6>
        </div>
        <div class="card-body p-4">
            <p class="text-dark">Bạn có chắc chắn muốn xóa hồ sơ khách hàng <strong>@Model.FullName</strong> (Mã: <code>@Model.GuestId</code>) khỏi hệ thống không?</p>
            <div class="p-3 bg-light rounded-3 mb-3">
                <div class="row g-2 small">
                    <div class="col-sm-4 text-muted">Số điện thoại:</div>
                    <div class="col-sm-8 fw-semibold text-dark">@Model.Phone</div>
                    <div class="col-sm-4 text-muted">Địa chỉ email:</div>
                    <div class="col-sm-8 fw-semibold text-dark">@Model.Email</div>
                    <div class="col-sm-4 text-muted">Số CCCD/CMND:</div>
                    <div class="col-sm-8 fw-semibold text-dark">@Model.NationalId</div>
                </div>
            </div>
            <div class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>Thao tác này sẽ xóa vĩnh viễn dữ liệu khách hàng khỏi hệ thống và không thể hoàn tác.
            </div>
        </div>
        <div class="card-footer bg-white p-3 px-4 border-top d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-light border px-4">Hủy bỏ</a>
            <form asp-action="Delete" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.GuestId" />
                <button type="submit" class="btn btn-danger px-4 fw-semibold">
                    <i class="bi bi-trash me-1"></i> Xác Nhận Xóa
                </button>
            </form>
        </div>
    </div>
</div>
