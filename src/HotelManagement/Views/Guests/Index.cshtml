@model IEnumerable<HotelManagement.Models.Guest>
@{
    ViewData["Title"] = "Hồ Sơ Khách Hàng";
}

<div class="container-fluid px-0">
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb" class="mono-breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item text-secondary">Lễ tân & lưu trú</li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Khách hàng</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Hồ Sơ & Danh Bạ Khách Hàng</h1>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="Create" class="mono-btn-dark">
                <i class="bi bi-person-plus me-1"></i> Thêm Khách Hàng Mới
            </a>
        </div>
    </div>

    <!-- THANH TÌM KIẾM KHÁCH HÀNG (TASK-106) -->
    <div class="mono-card mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-7 col-lg-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-secondary-subtle">
                            <i class="bi bi-search text-secondary"></i>
                        </span>
                        <input type="text" 
                               name="searchTerm" 
                               value="@ViewBag.SearchTerm" 
                               class="form-control mono-form-control" 
                               placeholder="Tìm theo Mã khách hàng (VD: GUEST001) hoặc Số điện thoại, Họ tên..." 
                               autocomplete="off" />
                    </div>
                </div>
                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn mono-btn-dark fw-semibold px-4">
                        <i class="bi bi-search me-1"></i> Tìm Kiếm
                    </button>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                            <i class="bi bi-x-circle me-1"></i> Xóa Bộ Lọc
                        </a>
                    }
                </div>
            </form>

            @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string))
            {
                <div class="mt-3 pt-3 border-top d-flex flex-wrap align-items-center justify-content-between text-muted small gap-2">
                    <div>
                        <i class="bi bi-funnel-fill text-dark me-1"></i>
                        Kết quả lọc theo từ khóa: <strong class="text-dark font-monospace">"@ViewBag.SearchTerm"</strong>
                        <span class="badge bg-secondary-subtle text-dark border ms-2">Tìm thấy @Model.Count() khách hàng</span>
                    </div>
                    <a asp-action="Index" class="text-decoration-none text-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Xem tất cả danh sách
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="mono-card overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <div class="fw-bold text-dark">
                <i class="bi bi-people me-2 text-dark"></i>Danh Sách Khách Hàng
                <span class="mono-badge-light ms-2">@Model.Count() khách hàng</span>
            </div>
            <span class="text-muted small">Dữ liệu thành viên lưu trú</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase fw-semibold">
                    <tr>
                        <th style="width: 140px;">Mã KH</th>
                        <th>Họ Và Tên</th>
                        <th>Số Điện Thoại</th>
                        <th>Địa Chỉ Email</th>
                        <th>CCCD / CMND</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                @foreach (var guest in Model)
                {
                    <tr>
                        <td>
                            <span class="mono-badge-light font-monospace">
                                @guest.GuestId
                            </span>
                        </td>
                        <td class="fw-bold text-dark">@guest.FullName</td>
                        <td class="font-monospace small">
                            <a href="tel:@guest.Phone" class="text-decoration-none text-dark">
                                <i class="bi bi-telephone text-secondary me-1"></i>@guest.Phone
                            </a>
                        </td>
                        <td class="small">
                            <a href="mailto:@guest.Email" class="text-decoration-none text-dark">
                                <i class="bi bi-envelope text-secondary me-1"></i>@guest.Email
                            </a>
                        </td>
                        <td class="font-monospace small text-secondary">@guest.NationalId</td>
                        <td class="text-end pe-4">
                            <div class="btn-group btn-group-sm">
                                <a asp-controller="BookingHistory" asp-action="Index" asp-route-customerId="@guest.GuestId" class="mono-btn-outline btn-sm" title="Lịch sử lưu trú">
                                    <i class="bi bi-clock-history"></i> Lịch sử
                                </a>
                                <a asp-action="Details" asp-route-id="@guest.GuestId" class="mono-btn-outline btn-sm" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                                <a asp-action="Edit" asp-route-id="@guest.GuestId" class="mono-btn-outline btn-sm" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@guest.GuestId" class="mono-btn-outline btn-sm" title="Xóa">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                            @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string))
                            {
                                <div class="fw-semibold text-dark">Không tìm thấy khách hàng nào khớp với từ khóa "@ViewBag.SearchTerm".</div>
                                <div class="small text-secondary mt-1">Vui lòng kiểm tra lại mã khách hàng hoặc số điện thoại.</div>
                                <div class="mt-3">
                                    <a asp-action="Index" class="btn btn-sm mono-btn-dark">
                                        <i class="bi bi-arrow-left me-1"></i> Xem lại tất cả khách hàng
                                    </a>
                                </div>
                            }
                            else
                            {
                                <span>Chưa có dữ liệu khách hàng trong hệ thống.</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-3 px-4 border-top text-muted small d-flex justify-content-between align-items-center">
            <span>Tổng cộng <strong>@Model.Count()</strong> hồ sơ khách hàng.</span>
            <span>Grand Hotel PMS</span>
        </div>
    </div>
</div>
