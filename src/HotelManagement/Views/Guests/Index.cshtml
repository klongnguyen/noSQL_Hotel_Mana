@model IEnumerable<HotelManagement.Models.Guest>
@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="text-muted small mb-1">Nghiệp vụ lưu trú</div>
            <h2 class="h3 fw-bold mb-0">Quản lý Khách hàng</h2>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i> Thêm khách hàng
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 d-flex justify-content-between">
            <strong><i class="bi bi-people me-2 text-primary"></i>Danh sách khách hàng</strong>
            <span class="badge bg-primary-subtle text-primary">@Model.Count() khách hàng</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã KH</th>
                        <th>Họ tên</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>CCCD/CMND</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var guest in Model)
                {
                    <tr>
                        <td><span class="badge bg-secondary-subtle text-secondary font-monospace">@guest.GuestId</span></td>
                        <td class="fw-semibold">@guest.FullName</td>
                        <td>@guest.Phone</td>
                        <td>@guest.Email</td>
                        <td>@guest.NationalId</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@guest.GuestId" class="btn btn-outline-primary">Chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@guest.GuestId" class="btn btn-outline-warning">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@guest.GuestId" class="btn btn-outline-danger">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-5 text-muted">Chưa có dữ liệu khách hàng.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
