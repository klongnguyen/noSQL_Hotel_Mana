@model IEnumerable<HotelManagement.Models.Guest>
@{
    ViewData["Title"] = "Hồ Sơ Khách Hàng";
}

<div class="container-fluid px-0">
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb" class="mono-breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item text-secondary">Lễ tân & lưu trú</li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Khách hàng</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Hồ Sơ & Danh Bạ Khách Hàng</h1>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-action="Create" class="mono-btn-dark">
                <i class="bi bi-person-plus me-1"></i> Thêm Khách Hàng Mới
            </a>
        </div>
    </div>

    <div class="mono-card overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <div class="fw-bold text-dark">
                <i class="bi bi-people me-2 text-dark"></i>Danh Sách Khách Hàng
                <span class="mono-badge-light ms-2">@Model.Count() khách hàng</span>
            </div>
            <span class="text-muted small">Dữ liệu thành viên lưu trú</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase fw-semibold">
                    <tr>
                        <th style="width: 140px;">Mã KH</th>
                        <th>Họ Và Tên</th>
                        <th>Số Điện Thoại</th>
                        <th>Địa Chỉ Email</th>
                        <th>CCCD / CMND</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                @foreach (var guest in Model)
                {
                    <tr>
                        <td>
                            <span class="mono-badge-light font-monospace">
                                @guest.GuestId
                            </span>
                        </td>
                        <td class="fw-bold text-dark">@guest.FullName</td>
                        <td class="font-monospace small">
                            <a href="tel:@guest.Phone" class="text-decoration-none text-dark">
                                <i class="bi bi-telephone text-secondary me-1"></i>@guest.Phone
                            </a>
                        </td>
                        <td class="small">
                            <a href="mailto:@guest.Email" class="text-decoration-none text-dark">
                                <i class="bi bi-envelope text-secondary me-1"></i>@guest.Email
                            </a>
                        </td>
                        <td class="font-monospace small text-secondary">@guest.NationalId</td>
                        <td class="text-end pe-4">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@guest.GuestId" class="mono-btn-outline btn-sm" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                                <a asp-action="Edit" asp-route-id="@guest.GuestId" class="mono-btn-outline btn-sm" title="Chỉnh sửa">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@guest.GuestId" class="mono-btn-outline btn-sm" title="Xóa">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                            Chưa có dữ liệu khách hàng trong hệ thống.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white py-3 px-4 border-top text-muted small d-flex justify-content-between align-items-center">
            <span>Tổng cộng <strong>@Model.Count()</strong> hồ sơ khách hàng.</span>
            <span>Grand Hotel PMS</span>
        </div>
    </div>
</div>
