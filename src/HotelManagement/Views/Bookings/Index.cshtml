@model IEnumerable<HotelManagement.Models.Booking>
@{
    ViewData["Title"] = "Quản Lý Đặt Phòng";
    var guestId = ViewBag.GuestId as string;
}

<div class="container-fluid px-0">
    <div class="d-md-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small mono-breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item text-secondary">Lễ tân & lưu trú</li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Đặt phòng</li>
                </ol>
            </nav>
            <h2 class="h4 fw-bold text-dark mb-0">Quản Lý Đơn Đặt Phòng</h2>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Create" class="btn mono-btn-dark fw-semibold">
                <i class="bi bi-calendar-plus me-1"></i> Tạo Đặt Phòng Mới
            </a>
        </div>
    </div>

    <!-- Khung tra cứu đơn đặt phòng theo khách hàng -->
    <div class="mono-card mb-4">
        <div class="card-body p-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-search text-dark me-2"></i>Tra Cứu Đơn Đặt Phòng Theo Khách Hàng</h6>
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-secondary-subtle"><i class="bi bi-person text-secondary"></i></span>
                        <input name="guestId" value="@guestId" class="form-control mono-form-control" placeholder="Nhập mã khách hàng (Ví dụ: GUEST001)..." required />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn mono-btn-dark fw-semibold px-4">
                        <i class="bi bi-search me-1"></i> Tìm Kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(guestId))
    {
        <div class="mono-card overflow-hidden">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <div class="fw-bold text-dark">
                    <i class="bi bi-receipt me-2 text-dark"></i>Danh Sách Đơn Đặt Phòng Của Khách Hàng: 
                    <span class="mono-badge-dark font-monospace px-2 py-1 ms-1">@guestId</span>
                </div>
                <span class="mono-badge-light">@Model.Count() đơn</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4">Mã Booking</th>
                            <th>Chi Nhánh Khách Sạn</th>
                            <th>Số Phòng</th>
                            <th>Ngày Check-in</th>
                            <th>Ngày Check-out</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-4">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-monospace small fw-bold text-dark ps-4">@item.BookingId</td>
                            <td>
                                <div class="fw-semibold text-dark">@item.HotelName</div>
                                <small class="text-secondary font-monospace">@item.HotelId</small>
                            </td>
                            <td>
                                <span class="mono-badge-dark font-monospace">P.@item.RoomNumber</span>
                            </td>
                            <td class="text-secondary">@item.CheckInDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-secondary">@item.CheckOutDate.ToString("dd/MM/yyyy")</td>
                            <td class="fw-bold text-dark font-monospace">@item.TotalAmount.ToString("N0") VNĐ</td>
                            <td>
                                @if (item.Status == "CONFIRMED" || item.Status == "COMPLETED" || item.Status == "OCCUPIED")
                                {
                                    <span class="mono-badge-dark px-2 py-1">
                                        <i class="bi bi-check2 me-1"></i>@item.Status
                                    </span>
                                }
                                else if (item.Status == "CANCELLED")
                                {
                                    <span class="mono-badge-secondary px-2 py-1">
                                        Đã hủy
                                    </span>
                                }
                                else
                                {
                                    <span class="mono-badge-light px-2 py-1">
                                        @item.Status
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (!item.Status.Equals("CANCELLED", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form asp-action="Cancel" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn hủy đơn đặt phòng này?');">
                                        <input type="hidden" name="bookingId" value="@item.BookingId" />
                                        <input type="hidden" name="guestId" value="@item.GuestId" />
                                        <input type="hidden" name="hotelId" value="@item.HotelId" />
                                        <input type="hidden" name="roomNumber" value="@item.RoomNumber" />
                                        <input type="hidden" name="checkInDate" value="@item.CheckInDate.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="btn mono-btn-outline btn-sm">
                                            <i class="bi bi-x-circle me-1"></i> Hủy đơn
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Không khả dụng</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Khách hàng chưa có lịch sử đặt phòng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="mono-card p-5 text-center">
            <div class="text-muted">
                <i class="bi bi-person-badge fs-1 d-block mb-3 text-dark"></i>
                <h5 class="fw-bold text-dark">Vui lòng nhập Mã Khách Hàng để hiển thị danh sách đơn đặt phòng</h5>
                <p class="small text-secondary mb-0">Bạn có thể tìm kiếm theo mã khách hàng (ví dụ: GUEST001, GUEST002...).</p>
            </div>
        </div>
    }
</div>
