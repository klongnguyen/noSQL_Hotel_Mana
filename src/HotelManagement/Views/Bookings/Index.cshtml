@model IEnumerable<HotelManagement.Models.Booking>
@{
    ViewData["Title"] = "Quản lý đặt phòng";
    var guestId = ViewBag.GuestId as string;
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="text-muted small mb-1">Nghiệp vụ lưu trú</div>
            <h2 class="h3 fw-bold mb-0">Quản lý Đặt phòng</h2>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-calendar-plus me-1"></i> Đặt phòng mới
        </a>
    </div>

    <form method="get" asp-action="Index" class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <label class="form-label fw-semibold">Mã khách hàng</label>
            <div class="input-group" style="max-width:500px">
                <input name="guestId" value="@guestId" class="form-control" placeholder="Ví dụ: GUEST001" required />
                <button class="btn btn-primary">Tra cứu</button>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(guestId))
    {
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-header bg-white py-3">
                <strong>Booking của @guestId</strong>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Booking</th>
                            <th>Khách sạn</th>
                            <th>Phòng</th>
                            <th>Check-in</th>
                            <th>Check-out</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-monospace small">@item.BookingId</td>
                            <td>@item.HotelName<br /><small class="text-muted">@item.HotelId</small></td>
                            <td>@item.RoomNumber</td>
                            <td>@item.CheckInDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.CheckOutDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.TotalAmount.ToString("N0") VNĐ</td>
                            <td>
                                <span class="badge @(item.Status == "CANCELLED" ? "bg-secondary" : "bg-success")">
                                    @item.Status
                                </span>
                            </td>
                            <td class="text-end">
                                @if (!item.Status.Equals("CANCELLED", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form asp-action="Cancel" method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn hủy booking này?');">
                                        <input type="hidden" name="bookingId" value="@item.BookingId" />
                                        <input type="hidden" name="guestId" value="@item.GuestId" />
                                        <input type="hidden" name="hotelId" value="@item.HotelId" />
                                        <input type="hidden" name="roomNumber" value="@item.RoomNumber" />
                                        <input type="hidden" name="checkInDate" value="@item.CheckInDate.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Hủy booking
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Đã hủy</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center py-5 text-muted">Khách hàng chưa có booking.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
