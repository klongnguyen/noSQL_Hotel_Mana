@model HotelManagement.Models.Booking
@{
    ViewData["Title"] = "Đặt Phòng Mới";
    var guests = ViewBag.Guests as IEnumerable<HotelManagement.Models.Guest> ?? Enumerable.Empty<HotelManagement.Models.Guest>();
    var hotels = ViewBag.Hotels as IEnumerable<HotelManagement.Models.Hotel> ?? Enumerable.Empty<HotelManagement.Models.Hotel>();
    var rooms = ViewBag.Rooms as IEnumerable<HotelManagement.Models.Room> ?? Enumerable.Empty<HotelManagement.Models.Room>();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <style>
        .flatpickr-calendar {
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15) !important;
            border: 1px solid #1e293b !important;
            border-radius: 8px !important;
            font-family: inherit !important;
        }
        .flatpickr-day.selected, 
        .flatpickr-day.startRange, 
        .flatpickr-day.endRange,
        .flatpickr-day.selected:hover,
        .flatpickr-day.startRange:hover,
        .flatpickr-day.endRange:hover {
            background: #0f172a !important;
            border-color: #0f172a !important;
            color: #ffffff !important;
            font-weight: 600;
        }
        .flatpickr-day.inRange {
            background: #e2e8f0 !important;
            border-color: #e2e8f0 !important;
            color: #0f172a !important;
            box-shadow: -5px 0 0 #e2e8f0, 5px 0 0 #e2e8f0 !important;
        }
        .flatpickr-day.flatpickr-disabled, 
        .flatpickr-day.flatpickr-disabled:hover {
            background: #f8fafc !important;
            color: #cbd5e1 !important;
            text-decoration: line-through !important;
            cursor: not-allowed !important;
        }
        .step-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background-color: #0f172a;
            color: #ffffff;
            font-size: 12px;
            font-weight: bold;
            margin-right: 8px;
        }
        .room-opt-available {
            color: #047857;
            font-weight: 600;
        }
        .room-opt-disabled {
            color: #94a3b8;
            background-color: #f8fafc;
        }
    </style>
}

<div class="container" style="max-width:920px">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small mono-breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Bookings" asp-action="Index">Đặt phòng</a></li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Tạo mới</li>
                </ol>
            </nav>
            <h2 class="h4 fw-bold text-dark mb-0">Tạo Đơn Đặt Phòng Mới</h2>
        </div>
        <a asp-action="Index" class="btn mono-btn-outline btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <form asp-action="Create" method="post" id="bookingForm" class="mono-card overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h6 class="fw-bold text-dark mb-0">
                <i class="bi bi-calendar2-check text-dark me-2"></i>Quy Trình Tiếp Nhận Đặt Phòng (Date-First Flow)
            </h6>
        </div>
        <div class="card-body p-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger border small mb-4"></div>
            }

            <div class="row g-4">
                <!-- BƯỚC 1: KHÁCH HÀNG & CHI NHÁNH -->
                <div class="col-12">
                    <div class="d-flex align-items-center mb-2">
                        <span class="step-pill">1</span>
                        <h6 class="fw-bold text-dark mb-0 text-uppercase small tracking-wider">Thông Tin Khách Hàng & Chi Nhánh Khách Sạn</h6>
                    </div>
                    <div class="row g-3">
                        <!-- 1. Mã Khách Hàng (Datalist Autocomplete) -->
                        <div class="col-md-6">
                            <label asp-for="GuestId" class="form-label fw-semibold small text-secondary">
                                Mã Khách Hàng <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-dark"><i class="bi bi-person-badge"></i></span>
                                <input asp-for="GuestId" list="guestList" id="guestInput" class="form-control mono-form-control" 
                                       placeholder="Gõ hoặc chọn mã khách (GUEST001)..." required autocomplete="off" />
                            </div>
                            <span asp-validation-for="GuestId" class="text-danger small d-block mt-1"></span>
                            <datalist id="guestList">
                                @foreach (var g in guests)
                                {
                                    <option value="@g.GuestId" data-name="@g.FullName" data-phone="@g.Phone" data-email="@g.Email" data-nationalid="@g.NationalId">
                                        @g.GuestId - @g.FullName (@g.Phone)
                                    </option>
                                }
                            </datalist>
                            
                            <div id="guestInfoBox" class="mt-2 p-2 bg-light border rounded small d-none">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-person-check text-dark me-1"></i>
                                        <strong id="guestNameText" class="text-dark"></strong>
                                        <span id="guestPhoneText" class="text-secondary ms-2"></span>
                                    </div>
                                    <span class="badge bg-dark text-white"><i class="bi bi-check2 me-1"></i>Khách hợp lệ</span>
                                </div>
                            </div>
                            <div id="guestErrorBox" class="mt-1 small text-danger d-none">
                                <i class="bi bi-exclamation-triangle me-1"></i>Mã khách hàng chưa tồn tại trong cơ sở dữ liệu.
                            </div>
                        </div>

                        <!-- 2. Chi Nhánh Khách Sạn (Datalist Autocomplete) -->
                        <div class="col-md-6">
                            <label asp-for="HotelId" class="form-label fw-semibold small text-secondary">
                                Chi Nhánh Khách Sạn <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-dark"><i class="bi bi-building"></i></span>
                                <input asp-for="HotelId" list="hotelList" id="hotelInput" class="form-control mono-form-control" 
                                       placeholder="Gõ hoặc chọn chi nhánh (HTL001)..." required autocomplete="off" />
                            </div>
                            <span asp-validation-for="HotelId" class="text-danger small d-block mt-1"></span>
                            <datalist id="hotelList">
                                @foreach (var h in hotels)
                                {
                                    <option value="@h.HotelId" data-name="@h.HotelName" data-city="@h.City" data-stars="@h.StarRating" data-address="@h.Address">
                                        @h.HotelId - @h.HotelName (@h.City)
                                    </option>
                                }
                            </datalist>

                            <div id="hotelInfoBox" class="mt-2 p-2 bg-light border rounded small d-none">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-geo-alt text-dark me-1"></i>
                                        <strong id="hotelNameText" class="text-dark"></strong>
                                        <span id="hotelCityText" class="text-secondary ms-2"></span>
                                    </div>
                                    <span id="hotelStarsBadge" class="badge bg-secondary text-white"></span>
                                </div>
                            </div>
                            <div id="hotelErrorBox" class="mt-1 small text-danger d-none">
                                <i class="bi bi-exclamation-triangle me-1"></i>Mã khách sạn không tồn tại trong hệ thống.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BƯỚC 2: THỜI GIAN LƯU TRÚ (CHỌN TRƯỚC ĐỂ LỌC PHÒNG TRỐNG) -->
                <div class="col-12">
                    <div class="p-3 bg-light border rounded-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center">
                                <span class="step-pill">2</span>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0 text-uppercase small tracking-wider">Thời Gian Lưu Trú Dự Kiến (Chọn Ngày Trước)</h6>
                                    <span class="text-muted small">Hệ thống sẽ tra cứu lịch sử đặt phòng của chi nhánh để phát hiện phòng nào còn trống hoặc đã có người đặt trong khoảng này.</span>
                                </div>
                            </div>
                            <span id="stayDurationBadge" class="badge bg-dark text-white px-2 py-1">
                                <i class="bi bi-moon-stars me-1"></i>1 đêm
                            </span>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label asp-for="CheckInDate" class="form-label fw-semibold small text-secondary">
                                    Ngày Nhận Phòng (Check-in) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-dark"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="CheckInDate" id="checkInInput" type="text" 
                                           class="form-control mono-form-control bg-white" 
                                           value="@Model.CheckInDate.ToString("yyyy-MM-dd")" 
                                           placeholder="Chọn ngày nhận phòng..." required />
                                </div>
                                <span asp-validation-for="CheckInDate" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CheckOutDate" class="form-label fw-semibold small text-secondary">
                                    Ngày Trả Phòng (Check-out) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white text-dark"><i class="bi bi-calendar-check"></i></span>
                                    <input asp-for="CheckOutDate" id="checkOutInput" type="text" 
                                           class="form-control mono-form-control bg-white" 
                                           value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" 
                                           placeholder="Chọn ngày trả phòng..." required />
                                </div>
                                <span asp-validation-for="CheckOutDate" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BƯỚC 3: CHỌN BUỒNG PHÒNG KHẢ DỤNG (ĐÃ ĐƯỢC LỌC THEO NGÀY) -->
                <div class="col-12">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center">
                            <span class="step-pill">3</span>
                            <h6 class="fw-bold text-dark mb-0 text-uppercase small tracking-wider">Lựa Chọn Buồng Phòng Khả Dụng</h6>
                        </div>
                        <span id="roomAvailabilityStats" class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                            <span class="spinner-border spinner-border-sm me-1"></span> Đang nạp tình trạng phòng...
                        </span>
                    </div>

                    <div class="input-group">
                        <span class="input-group-text bg-light text-dark"><i class="bi bi-door-open"></i></span>
                        <select asp-for="RoomNumber" id="roomSelect" class="form-select mono-form-control" required>
                            @foreach (var r in rooms)
                            {
                                <option value="@r.RoomNumber" 
                                        data-type="@r.RoomType" 
                                        data-price="@r.PricePerNight" 
                                        data-status="@r.Status"
                                        data-capacity="@r.Capacity"
                                        data-available="true"
                                        selected="@(r.RoomNumber == Model.RoomNumber)">
                                    Phòng @r.RoomNumber - Hạng @r.RoomType (Tối đa @r.Capacity người)
                                </option>
                            }
                        </select>
                    </div>
                    <span asp-validation-for="RoomNumber" class="text-danger small d-block mt-1"></span>

                    <!-- Cảnh báo nếu toàn bộ phòng kín lịch -->
                    <div id="noAvailableRoomsAlert" class="alert alert-warning border small mt-2 d-none">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <strong>Toàn bộ phòng đã kín lịch!</strong> Chi nhánh này hiện không còn phòng trống nào trong khoảng ngày đã chọn. Vui lòng đổi ngày lưu trú hoặc chọn chi nhánh khách sạn khác.
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="small text-muted" id="roomHelperText">
                            <i class="bi bi-shield-check text-success me-1"></i>Các phòng đã có người đặt trong khoảng ngày bạn chọn sẽ tự động bị khóa (disabled).
                        </span>
                        <span class="badge bg-dark text-white px-2 py-1" id="roomCapacityBadge">
                            <i class="bi bi-people-fill me-1"></i>Sức chứa tối đa: 2 người
                        </span>
                    </div>
                </div>

                <!-- BƯỚC 4: SỐ LƯỢNG KHÁCH LƯU TRÚ & NGƯỜI Ở CÙNG -->
                <div class="col-12">
                    <div class="p-3 bg-light border rounded-3">
                        <div class="row align-items-center mb-3">
                            <div class="col-md-7">
                                <div class="d-flex align-items-center">
                                    <span class="step-pill">4</span>
                                    <h6 class="fw-bold text-dark mb-0 text-uppercase small tracking-wider">
                                        Số Lượng Khách Lưu Trú & Khai Báo Ở Cùng
                                    </h6>
                                </div>
                            </div>
                            <div class="col-md-5 text-md-end mt-2 mt-md-0">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <label asp-for="NumberOfOccupants" class="small fw-bold text-dark text-nowrap mb-0">
                                        Số người ở:
                                    </label>
                                    <select asp-for="NumberOfOccupants" id="occupantCountSelect" class="form-select form-select-sm mono-form-control" style="width: 130px;">
                                        <option value="1">1 người</option>
                                        <option value="2">2 người</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <span asp-validation-for="NumberOfOccupants" class="text-danger small d-block mb-2"></span>

                        <!-- Danh sách chi tiết người ở cùng phòng -->
                        <div id="occupantsContainer" class="d-flex flex-column gap-2">
                            <!-- Sẽ được JavaScript tự động tạo các dòng nhập -->
                        </div>
                        
                        <div id="occupantsErrorAlert" class="alert alert-danger small py-2 px-3 mt-2 d-none">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Vui lòng nhập đầy đủ Họ và tên và CCCD/CMND cho tất cả người ở cùng phòng.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cảnh Báo Trùng Lịch / Không Liên Tục -->
            <div id="conflictAlert" class="alert alert-danger border d-none mt-3 mb-0">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-octagon-fill fs-5 text-danger"></i>
                    <div>
                        <strong>Xung Đột Lịch Đặt Buồng Phòng!</strong>
                        <div id="conflictMessage" class="small mt-1"></div>
                    </div>
                </div>
            </div>

            <!-- Bảng Lịch Trình Buồng Phòng Được Chọn (Visual Schedule Table) -->
            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-clock-history me-2"></i>Lịch Đã Đặt Của Buồng Phòng Được Chọn
                    </h6>
                    <span id="roomScheduleBadge" class="badge bg-dark text-white">
                        <span class="spinner-border spinner-border-sm me-1"></span> Đang tải...
                    </span>
                </div>
                <div class="table-responsive border rounded bg-white" style="max-height: 180px; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-secondary">
                            <tr>
                                <th class="ps-3">Mã Booking</th>
                                <th>Khách Hàng</th>
                                <th>Nhận Phòng</th>
                                <th>Trả Phòng</th>
                                <th class="text-center">Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody id="roomScheduleBody">
                            <tr>
                                <td colspan="5" class="text-center py-3 text-muted small">
                                    Đang nạp lịch buồng phòng từ cơ sở dữ liệu...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Hộp Tóm Tắt Chi Phí -->
            <div class="card bg-light border-0 rounded-3 mt-4 p-3">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <span class="small text-secondary text-uppercase fw-semibold d-block">Đơn Giá Buồng Phòng</span>
                        <span id="pricePerNightText" class="fw-bold fs-6 text-dark">0 ₫</span>
                        <span class="small text-muted">/ đêm</span>
                    </div>
                    <div class="col-md-4">
                        <span class="small text-secondary text-uppercase fw-semibold d-block">Thời Lượng Lưu Trú</span>
                        <span id="nightsCountText" class="fw-bold fs-6 text-dark">1 đêm</span>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <span class="small text-secondary text-uppercase fw-semibold d-block">Tổng Chi Phí Tạm Tính</span>
                        <span id="totalAmountText" class="fw-bold fs-5 text-dark">0 ₫</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer bg-white p-3 px-4 border-top d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn mono-btn-outline px-4">Hủy bỏ</a>
            <button type="submit" id="submitBookingBtn" class="btn mono-btn-dark px-4 fw-semibold">
                <i class="bi bi-check2 me-1"></i> Xác Nhận Đặt Phòng
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const guestInput = document.getElementById("guestInput");
            const guestList = document.getElementById("guestList");
            const guestInfoBox = document.getElementById("guestInfoBox");
            const guestNameText = document.getElementById("guestNameText");
            const guestPhoneText = document.getElementById("guestPhoneText");
            const guestErrorBox = document.getElementById("guestErrorBox");

            const hotelInput = document.getElementById("hotelInput");
            const hotelList = document.getElementById("hotelList");
            const hotelInfoBox = document.getElementById("hotelInfoBox");
            const hotelNameText = document.getElementById("hotelNameText");
            const hotelCityText = document.getElementById("hotelCityText");
            const hotelStarsBadge = document.getElementById("hotelStarsBadge");
            const hotelErrorBox = document.getElementById("hotelErrorBox");

            const roomSelect = document.getElementById("roomSelect");
            const checkInInput = document.getElementById("checkInInput");
            const checkOutInput = document.getElementById("checkOutInput");
            const stayDurationBadge = document.getElementById("stayDurationBadge");
            const roomAvailabilityStats = document.getElementById("roomAvailabilityStats");
            const noAvailableRoomsAlert = document.getElementById("noAvailableRoomsAlert");

            const conflictAlert = document.getElementById("conflictAlert");
            const conflictMessage = document.getElementById("conflictMessage");
            const submitBtn = document.getElementById("submitBookingBtn");

            const roomScheduleBadge = document.getElementById("roomScheduleBadge");
            const roomScheduleBody = document.getElementById("roomScheduleBody");

            const pricePerNightText = document.getElementById("pricePerNightText");
            const nightsCountText = document.getElementById("nightsCountText");
            const totalAmountText = document.getElementById("totalAmountText");

            // Phần quản lý sức chứa và người ở cùng
            const roomCapacityBadge = document.getElementById("roomCapacityBadge");
            const occupantCountSelect = document.getElementById("occupantCountSelect");
            const occupantsContainer = document.getElementById("occupantsContainer");
            const occupantsErrorAlert = document.getElementById("occupantsErrorAlert");

            let primaryGuestName = "";
            let primaryGuestCid = "";
            let currentMaxCapacity = 2;

            let currentBookedRanges = [];
            let fpCheckIn = null;
            let fpCheckOut = null;

            // 1. Helper: Định dạng tiền tệ VND
            function formatVND(amount) {
                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
            }

            // 2. Validate & hiển thị thông tin Khách Hàng từ Datalist
            function updateGuestInfo() {
                const val = (guestInput.value || "").trim().toUpperCase();
                guestInput.value = val;
                let found = null;
                const options = guestList.querySelectorAll("option");
                options.forEach(opt => {
                    if (opt.value.toUpperCase() === val) found = opt;
                });

                if (found) {
                    primaryGuestName = found.getAttribute("data-name") || "Khách Hàng";
                    primaryGuestCid = found.getAttribute("data-nationalid") || found.value || "";
                    guestNameText.textContent = primaryGuestName;
                    guestPhoneText.textContent = "| SĐT: " + (found.getAttribute("data-phone") || "N/A");
                    guestInfoBox.classList.remove("d-none");
                    guestErrorBox.classList.add("d-none");
                } else if (val.length > 0) {
                    primaryGuestName = val;
                    primaryGuestCid = val;
                    guestInfoBox.classList.add("d-none");
                    guestErrorBox.classList.remove("d-none");
                } else {
                    primaryGuestName = "";
                    primaryGuestCid = "";
                    guestInfoBox.classList.add("d-none");
                    guestErrorBox.classList.add("d-none");
                }
                updatePrimaryOccupantDisplay();
            }

            function updatePrimaryOccupantDisplay() {
                const nameElem = document.getElementById("occupant_primary_name");
                const cidElem = document.getElementById("occupant_primary_cid");
                const hiddenName = document.getElementById("hidden_primary_fullname");
                const hiddenCid = document.getElementById("hidden_primary_cid");

                if (nameElem) nameElem.textContent = primaryGuestName || "Chưa chọn khách";
                if (cidElem) cidElem.textContent = primaryGuestCid ? `CCCD: ${primaryGuestCid}` : "";
                if (hiddenName) hiddenName.value = primaryGuestName || "";
                if (hiddenCid) hiddenCid.value = primaryGuestCid || "";
            }

            guestInput.addEventListener("input", updateGuestInfo);
            guestInput.addEventListener("change", updateGuestInfo);

            // 3. Validate & hiển thị thông tin Khách Sạn từ Datalist
            function updateHotelInfo() {
                const val = (hotelInput.value || "").trim().toUpperCase();
                hotelInput.value = val;
                let found = null;
                const options = hotelList.querySelectorAll("option");
                options.forEach(opt => {
                    if (opt.value.toUpperCase() === val) found = opt;
                });

                if (found) {
                    hotelNameText.textContent = found.getAttribute("data-name") || "Chi Nhánh";
                    hotelCityText.textContent = "| " + (found.getAttribute("data-city") || "");
                    hotelStarsBadge.textContent = (found.getAttribute("data-stars") || "5") + " ⭐";
                    hotelInfoBox.classList.remove("d-none");
                    hotelErrorBox.classList.add("d-none");
                    // Nạp danh sách phòng tương ứng với chi nhánh và ngày đã chọn
                    loadRoomsForHotelAndDates();
                } else if (val.length > 0) {
                    hotelInfoBox.classList.add("d-none");
                    hotelErrorBox.classList.remove("d-none");
                } else {
                    hotelInfoBox.classList.add("d-none");
                    hotelErrorBox.classList.add("d-none");
                }
            }

            hotelInput.addEventListener("input", updateHotelInfo);
            hotelInput.addEventListener("change", updateHotelInfo);

            // 4. LẤY PHÒNG THEO KHÁCH SẠN VÀ DẢI NGÀY ĐÃ CHỌN (DATE-FIRST LOGIC)
            async function loadRoomsForHotelAndDates() {
                const hotelId = (hotelInput.value || "").trim();
                const checkIn = checkInInput.value;
                const checkOut = checkOutInput.value;

                if (!hotelId) return;

                roomAvailabilityStats.className = "badge bg-secondary text-white";
                roomAvailabilityStats.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang lọc phòng...`;

                try {
                    let url = `/Bookings/GetRooms?hotelId=${encodeURIComponent(hotelId)}`;
                    if (checkIn && checkOut) {
                        url += `&checkIn=${encodeURIComponent(checkIn)}&checkOut=${encodeURIComponent(checkOut)}`;
                    }

                    const response = await fetch(url);
                    if (!response.ok) return;
                    const rooms = await response.json();

                    const currentSelectedRoom = roomSelect.value;
                    roomSelect.innerHTML = "";

                    if (rooms.length === 0) {
                        const opt = document.createElement("option");
                        opt.value = "";
                        opt.textContent = "-- Không có phòng nào tại chi nhánh này --";
                        roomSelect.appendChild(opt);
                        roomAvailabilityStats.className = "badge bg-danger text-white";
                        roomAvailabilityStats.textContent = "0 phòng khả dụng";
                        noAvailableRoomsAlert.classList.remove("d-none");
                        submitBtn.disabled = true;
                        return;
                    }

                    let availableCount = 0;
                    let firstAvailableRoom = null;

                    rooms.forEach(r => {
                        const opt = document.createElement("option");
                        opt.value = r.roomNumber;
                        opt.setAttribute("data-type", r.roomType);
                        opt.setAttribute("data-price", r.pricePerNight);
                        opt.setAttribute("data-status", r.status);
                        opt.setAttribute("data-capacity", r.capacity || 2);
                        opt.setAttribute("data-available", r.isAvailable ? "true" : "false");

                        if (r.isAvailable) {
                            availableCount++;
                            opt.textContent = `Phòng ${r.roomNumber} - Hạng ${r.roomType} (${formatVND(r.pricePerNight)}/đêm)`;
                            opt.className = "room-opt-available";
                            if (!firstAvailableRoom) firstAvailableRoom = r.roomNumber.toString();
                            if (r.roomNumber.toString() === currentSelectedRoom) {
                                opt.selected = true;
                            }
                        } else {
                            opt.disabled = true;
                            opt.className = "room-opt-disabled";
                            const reason = r.conflictReason ? `[${r.conflictReason}]` : `[Đã có người đặt]`;
                            opt.textContent = `Phòng ${r.roomNumber} - Hạng ${r.roomType} ${reason}`;
                        }

                        roomSelect.appendChild(opt);
                    });

                    // Nếu phòng đang chọn bị disabled hoặc chưa chọn, tự động chuyển sang phòng trống đầu tiên
                    const selectedOpt = roomSelect.options[roomSelect.selectedIndex];
                    if (!selectedOpt || selectedOpt.disabled) {
                        if (firstAvailableRoom) {
                            roomSelect.value = firstAvailableRoom;
                        }
                    }

                    // Cập nhật thống kê phòng trống
                    if (availableCount > 0) {
                        roomAvailabilityStats.className = "badge bg-success-subtle text-success border border-success-subtle px-2 py-1";
                        roomAvailabilityStats.innerHTML = `<i class="bi bi-check-circle me-1"></i>${availableCount}/${rooms.length} phòng còn trống trong kỳ lưu trú`;
                        noAvailableRoomsAlert.classList.add("d-none");
                        submitBtn.disabled = false;
                        submitBtn.classList.remove("opacity-50");
                    } else {
                        roomAvailabilityStats.className = "badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1";
                        roomAvailabilityStats.innerHTML = `<i class="bi bi-x-circle me-1"></i>0/${rooms.length} phòng trống (Đã kín lịch)`;
                        noAvailableRoomsAlert.classList.remove("d-none");
                        submitBtn.disabled = true;
                        submitBtn.classList.add("opacity-50");
                    }

                    onRoomChanged();
                } catch (e) {
                    console.error("Lỗi nạp phòng theo ngày:", e);
                    roomAvailabilityStats.className = "badge bg-danger text-white";
                    roomAvailabilityStats.textContent = "Lỗi nạp phòng";
                }
            }

            // 5. Cập nhật sức chứa phòng & các ô nhập người ở cùng
            function updateOccupantCountOptions(capacity) {
                currentMaxCapacity = capacity;
                if (roomCapacityBadge) {
                    roomCapacityBadge.innerHTML = `<i class="bi bi-people-fill me-1"></i>Sức chứa tối đa: ${capacity} người`;
                }

                let currentVal = parseInt(occupantCountSelect.value, 10) || 1;
                if (currentVal > capacity) currentVal = capacity;
                if (currentVal < 1) currentVal = 1;

                occupantCountSelect.innerHTML = "";
                for (let i = 1; i <= capacity; i++) {
                    const opt = document.createElement("option");
                    opt.value = i;
                    opt.textContent = `${i} người ${i === capacity ? '(Tối đa)' : ''}`;
                    if (i === currentVal) opt.selected = true;
                    occupantCountSelect.appendChild(opt);
                }

                renderOccupants();
            }

            function renderOccupants() {
                const count = parseInt(occupantCountSelect.value, 10) || 1;
                
                // Lưu tạm thông tin đang nhập để khi đổi số lượng không mất
                const existingData = [];
                for (let i = 1; i <= 10; i++) {
                    const fn = document.getElementById(`occ_fn_${i}`);
                    const cid = document.getElementById(`occ_cid_${i}`);
                    const dob = document.getElementById(`occ_dob_${i}`);
                    if (fn || cid) {
                        existingData[i] = {
                            fullName: fn ? fn.value : "",
                            citizenId: cid ? cid.value : "",
                            dob: dob ? dob.value : ""
                        };
                    }
                }

                occupantsContainer.innerHTML = "";

                // Dòng 1: Khách chính (Đại diện)
                const p1 = document.createElement("div");
                p1.className = "p-2 bg-white border rounded d-flex justify-content-between align-items-center";
                p1.innerHTML = `
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-dark px-2 py-1"><i class="bi bi-star-fill me-1 text-warning"></i>Khách chính (Đại diện)</span>
                        <div>
                            <strong class="text-dark" id="occupant_primary_name">${primaryGuestName || "Chưa chọn khách"}</strong>
                            <span class="text-muted small ms-2" id="occupant_primary_cid">${primaryGuestCid ? `CCCD: ${primaryGuestCid}` : ''}</span>
                        </div>
                    </div>
                    <input type="hidden" name="Occupants[0].FullName" id="hidden_primary_fullname" value="${primaryGuestName || ''}" />
                    <input type="hidden" name="Occupants[0].CitizenId" id="hidden_primary_cid" value="${primaryGuestCid || ''}" />
                    <input type="hidden" name="Occupants[0].IsPrimary" value="true" />
                    <span class="badge bg-success-subtle text-success border border-success-subtle small"><i class="bi bi-shield-check me-1"></i>Chủ đơn</span>
                `;
                occupantsContainer.appendChild(p1);

                // Dòng 2..count: Người ở cùng phòng
                for (let i = 1; i < count; i++) {
                    const rowData = existingData[i] || { fullName: "", citizenId: "", dob: "" };
                    const card = document.createElement("div");
                    card.className = "p-3 bg-white border rounded";
                    card.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary text-white"><i class="bi bi-person me-1"></i>Người ở cùng #${i + 1}</span>
                        </div>
                        <input type="hidden" name="Occupants[${i}].IsPrimary" value="false" />
                        <div class="row g-2">
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold text-secondary mb-1">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" name="Occupants[${i}].FullName" id="occ_fn_${i}" value="${rowData.fullName}" 
                                       class="form-control form-control-sm mono-form-control" placeholder="Ví dụ: Trần Thị B..." required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold text-secondary mb-1">Số CCCD / CMND <span class="text-danger">*</span></label>
                                <input type="text" name="Occupants[${i}].CitizenId" id="occ_cid_${i}" value="${rowData.citizenId}" 
                                       class="form-control form-control-sm mono-form-control font-monospace" 
                                       placeholder="12 chữ số CCCD..." pattern="\\d{12}" maxlength="12" minlength="12" 
                                       title="Số CCCD phải gồm đúng 12 chữ số" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold text-secondary mb-1">Ngày sinh</label>
                                <input type="date" name="Occupants[${i}].DateOfBirth" id="occ_dob_${i}" value="${rowData.dob}" 
                                       class="form-control form-control-sm mono-form-control" />
                            </div>
                        </div>
                    `;
                    occupantsContainer.appendChild(card);
                }

                if (count <= 1) {
                    occupantsErrorAlert.classList.add("d-none");
                }
            }

            occupantCountSelect.addEventListener("change", renderOccupants);

            // 6. Khi chọn buồng phòng: Cập nhật giá, sức chứa & Bảng lịch đặt chi tiết của phòng đó
            async function onRoomChanged() {
                const hotelId = (hotelInput.value || "").trim();
                const roomNumber = roomSelect.value;
                updatePriceCalculation();

                const selectedOption = roomSelect.options[roomSelect.selectedIndex];
                if (!selectedOption || selectedOption.disabled) {
                    return;
                }

                const capacity = parseInt(selectedOption.getAttribute("data-capacity") || "2", 10);
                updateOccupantCountOptions(capacity);

                if (!hotelId || !roomNumber) {
                    currentBookedRanges = [];
                    return;
                }

                roomScheduleBadge.className = "badge bg-secondary text-white";
                roomScheduleBadge.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Đang tải...`;

                try {
                    const response = await fetch(`/Bookings/GetBookedDates?hotelId=${encodeURIComponent(hotelId)}&roomNumber=${encodeURIComponent(roomNumber)}`);
                    if (!response.ok) throw new Error("Lỗi API");
                    const bookings = await response.json();

                    // Render bảng lịch trình buồng phòng
                    roomScheduleBody.innerHTML = "";
                    currentBookedRanges = [];

                    if (bookings.length === 0) {
                        roomScheduleBadge.className = "badge bg-dark text-white";
                        roomScheduleBadge.textContent = "0 Đơn - Hoàn toàn trống lịch";
                        roomScheduleBody.innerHTML = `
                            <tr>
                                <td colspan="5" class="text-center py-3 text-muted small">
                                    <i class="bi bi-check-circle text-dark me-1"></i>
                                    Phòng hiện chưa có đơn đặt trước. Tất cả các ngày đều sẵn sàng tiếp nhận!
                                </td>
                            </tr>`;
                    } else {
                        roomScheduleBadge.className = "badge bg-dark text-white";
                        roomScheduleBadge.textContent = `${bookings.length} Đơn đã đặt trước`;

                        bookings.forEach(b => {
                            currentBookedRanges.push({
                                from: b.checkInDate,
                                to: b.checkOutDate,
                                bookingId: b.bookingId,
                                guestName: b.guestName
                            });

                            const tr = document.createElement("tr");
                            tr.innerHTML = `
                                <td class="ps-3 font-monospace small fw-semibold">${b.bookingId.substring(0, 8)}...</td>
                                <td class="small fw-semibold text-dark">${b.guestName || b.guestId}</td>
                                <td class="small text-danger fw-semibold"><i class="bi bi-box-arrow-in-right me-1"></i>${b.checkInDisplay}</td>
                                <td class="small text-secondary fw-semibold"><i class="bi bi-box-arrow-right me-1"></i>${b.checkOutDisplay}</td>
                                <td class="text-center">
                                    <span class="badge ${b.status === 'CONFIRMED' ? 'bg-dark' : 'bg-secondary'} text-white small">
                                        ${b.status}
                                    </span>
                                </td>
                            `;
                            roomScheduleBody.appendChild(tr);
                        });
                    }

                    validateDatesContinuity();
                } catch (e) {
                    console.error("Lỗi tải lịch buồng phòng:", e);
                    roomScheduleBadge.className = "badge bg-danger text-white";
                    roomScheduleBadge.textContent = "Lỗi nạp lịch";
                }
            }

            roomSelect.addEventListener("change", onRoomChanged);

            // 7. Khởi tạo Flatpickr cho bộ chọn Check-in & Check-out
            function initFlatpickr() {
                if (fpCheckIn) fpCheckIn.destroy();
                if (fpCheckOut) fpCheckOut.destroy();

                fpCheckIn = flatpickr("#checkInInput", {
                    locale: "vn",
                    dateFormat: "Y-m-d",
                    minDate: "today",
                    onChange: function (selectedDates, dateStr) {
                        if (selectedDates.length > 0) {
                            const minCheckOut = new Date(selectedDates[0]);
                            minCheckOut.setDate(minCheckOut.getDate() + 1);
                            fpCheckOut.set("minDate", minCheckOut);

                            if (fpCheckOut.selectedDates.length > 0 && fpCheckOut.selectedDates[0] <= selectedDates[0]) {
                                fpCheckOut.setDate(minCheckOut);
                            }
                        }
                        // Khi đổi ngày: tự động lọc lại các phòng khả dụng cho kỳ lưu trú này
                        loadRoomsForHotelAndDates();
                    }
                });

                fpCheckOut = flatpickr("#checkOutInput", {
                    locale: "vn",
                    dateFormat: "Y-m-d",
                    minDate: new Date().fp_incr(1),
                    onChange: function () {
                        // Khi đổi ngày trả phòng: lọc lại phòng khả dụng
                        loadRoomsForHotelAndDates();
                    }
                });
            }

            // 8. Kiểm tra tính liên tục của ngày đặt và xung đột lịch
            function validateDatesContinuity() {
                const inStr = checkInInput.value;
                const outStr = checkOutInput.value;

                if (!inStr || !outStr) {
                    hideConflict();
                    return true;
                }

                const checkInDate = new Date(inStr);
                const checkOutDate = new Date(outStr);

                if (checkOutDate <= checkInDate) {
                    showConflict("Ngày trả phòng (check-out) phải sau ngày nhận phòng ít nhất 1 đêm.");
                    return false;
                }

                let conflict = null;
                for (const r of currentBookedRanges) {
                    const bIn = new Date(r.from);
                    const bOut = new Date(r.to);

                    if (checkInDate < bOut && checkOutDate > bIn) {
                        conflict = r;
                        break;
                    }
                }

                if (conflict) {
                    const fromFormatted = new Date(conflict.from).toLocaleDateString('vi-VN');
                    const toFormatted = new Date(conflict.to).toLocaleDateString('vi-VN');
                    showConflict(`Phòng này đã có khách (${conflict.guestName || 'đã đặt'}) giữ phòng từ ngày ${fromFormatted} đến ${toFormatted} (Mã: ${conflict.bookingId.substring(0, 8)}...). Vui lòng chọn buồng phòng còn trống khác!`);
                    return false;
                }

                hideConflict();
                return true;
            }

            function showConflict(msg) {
                conflictMessage.textContent = msg;
                conflictAlert.classList.remove("d-none");
                submitBtn.disabled = true;
                submitBtn.classList.add("opacity-50");
            }

            function hideConflict() {
                conflictAlert.classList.add("d-none");
                const selectedOpt = roomSelect.options[roomSelect.selectedIndex];
                if (selectedOpt && !selectedOpt.disabled) {
                    submitBtn.disabled = false;
                    submitBtn.classList.remove("opacity-50");
                }
            }

            // 9. Tự động tính tiền theo giá phòng & số đêm
            function updatePriceCalculation() {
                const selectedOption = roomSelect.options[roomSelect.selectedIndex];
                const pricePerNight = selectedOption ? parseFloat(selectedOption.getAttribute("data-price") || 0) : 0;
                pricePerNightText.textContent = formatVND(pricePerNight);

                const inStr = checkInInput.value;
                const outStr = checkOutInput.value;

                if (inStr && outStr) {
                    const dIn = new Date(inStr);
                    const dOut = new Date(outStr);
                    const diffTime = dOut - dIn;
                    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                    if (diffDays > 0) {
                        stayDurationBadge.innerHTML = `<i class="bi bi-moon-stars me-1"></i>${diffDays} đêm`;
                        nightsCountText.textContent = `${diffDays} đêm`;
                        totalAmountText.textContent = formatVND(pricePerNight * diffDays);
                    } else {
                        stayDurationBadge.innerHTML = `<i class="bi bi-moon-stars me-1"></i>0 đêm`;
                        nightsCountText.textContent = `0 đêm`;
                        totalAmountText.textContent = `0 ₫`;
                    }
                } else {
                    stayDurationBadge.innerHTML = `<i class="bi bi-moon-stars me-1"></i>1 đêm`;
                    nightsCountText.textContent = `1 đêm`;
                    totalAmountText.textContent = formatVND(pricePerNight);
                }
            }

            // 10. Chặn submit nếu thiếu thông tin hoặc chọn phòng không hợp lệ
            document.getElementById("bookingForm").addEventListener("submit", function (e) {
                const selectedOpt = roomSelect.options[roomSelect.selectedIndex];
                if (!selectedOpt || selectedOpt.disabled) {
                    e.preventDefault();
                    alert("Buồng phòng bạn chọn hiện không khả dụng (đã có khách đặt hoặc đang bảo trì). Vui lòng chọn buồng phòng còn trống!");
                    return false;
                }

                if (!validateDatesContinuity()) {
                    e.preventDefault();
                    return false;
                }

                const count = parseInt(occupantCountSelect.value, 10) || 1;
                if (count > 1) {
                    let hasMissing = false;
                    for (let i = 1; i < count; i++) {
                        const fn = document.getElementById(`occ_fn_${i}`);
                        const cid = document.getElementById(`occ_cid_${i}`);
                        if (!fn || !fn.value.trim() || !cid || !cid.value.trim()) {
                            hasMissing = true;
                            if (fn && !fn.value.trim()) fn.focus();
                            else if (cid && !cid.value.trim()) cid.focus();
                            break;
                        }
                    }

                    if (hasMissing) {
                        e.preventDefault();
                        occupantsErrorAlert.classList.remove("d-none");
                        return false;
                    }

                    // Kiểm tra định dạng CCCD 12 số của người ở cùng
                    const ccdRegex = /^\d{12}$/;
                    const todayStr = new Date().toISOString().split('T')[0];
                    for (let i = 1; i < count; i++) {
                        const cid = document.getElementById(`occ_cid_${i}`);
                        const dob = document.getElementById(`occ_dob_${i}`);
                        if (cid && !ccdRegex.test(cid.value.trim())) {
                            e.preventDefault();
                            alert(`Số CCCD của người ở cùng #${i + 1} không hợp lệ! Bắt buộc phải gồm đúng 12 chữ số.`);
                            cid.focus();
                            return false;
                        }
                        if (dob && dob.value) {
                            if (dob.value > todayStr) {
                                e.preventDefault();
                                alert(`Ngày sinh của người ở cùng #${i + 1} không được lớn hơn ngày hiện tại!`);
                                dob.focus();
                                return false;
                            }
                        }
                    }
                }

                occupantsErrorAlert.classList.add("d-none");
                return true;
            });

            // Khởi động khởi tạo các bộ chọn
            initFlatpickr();
            updateGuestInfo();
            updateHotelInfo();
        });
    </script>
}
