@model HotelManagement.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Bảng Điều Khiển Quản Trị";
}

<div class="container-fluid px-0">
    <!-- Header Dashboard Tối Giản (Đã loại bỏ chữ chớp nháy, bỏ chữ Dashboard trong ngoặc, bỏ dòng chú thích phụ) -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 mb-0 text-dark fw-bold">Bảng Điều Khiển Quản Trị</h1>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-dark border-secondary shadow-sm mb-4" role="alert">
            <h6 class="alert-heading fw-bold mb-1"><i class="bi bi-exclamation-circle-fill me-2"></i>Thông báo kết nối cơ sở dữ liệu:</h6>
            <p class="mb-0 small text-secondary">@Model.ErrorMessage</p>
        </div>
    }

    <!-- 1. Hàng Thẻ Chỉ Số Hoạt Động (KPI Cards) - Phong Cách Monochrome Trắng Đen -->
    <div class="row g-3 mb-4">
        <!-- Khách sạn -->
        <div class="col-sm-6 col-xl-3">
            <a asp-controller="Hotels" asp-action="Index" class="text-decoration-none">
                <div class="mono-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-uppercase text-secondary fw-semibold small" style="letter-spacing: 0.05em; font-size: 0.75rem;">Cơ Sở Khách Sạn</span>
                            <h2 class="display-6 fw-bold mb-0 text-dark mt-1">@Model.HotelCount</h2>
                        </div>
                        <div class="mono-stat-icon">
                            <i class="bi bi-building"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light-subtle">
                        <span class="small text-muted" style="font-size: 0.8rem;">Chi nhánh toàn quốc</span>
                        <span class="small fw-semibold text-dark">Xem chi tiết &rarr;</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Phòng nghỉ -->
        <div class="col-sm-6 col-xl-3">
            <a asp-controller="Rooms" asp-action="Index" class="text-decoration-none">
                <div class="mono-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-uppercase text-secondary fw-semibold small" style="letter-spacing: 0.05em; font-size: 0.75rem;">Tổng Số Phòng</span>
                            <h2 class="display-6 fw-bold mb-0 text-dark mt-1">@Model.RoomCount</h2>
                        </div>
                        <div class="mono-stat-icon">
                            <i class="bi bi-door-open"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light-subtle">
                        <span class="small text-muted" style="font-size: 0.8rem;">Buồng phòng khả dụng</span>
                        <span class="small fw-semibold text-dark">Kiểm tra phòng &rarr;</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Khách hàng -->
        <div class="col-sm-6 col-xl-3">
            <a asp-controller="Guests" asp-action="Index" class="text-decoration-none">
                <div class="mono-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-uppercase text-secondary fw-semibold small" style="letter-spacing: 0.05em; font-size: 0.75rem;">Hồ Sơ Khách Hàng</span>
                            <h2 class="display-6 fw-bold mb-0 text-dark mt-1">@Model.GuestCount</h2>
                        </div>
                        <div class="mono-stat-icon">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light-subtle">
                        <span class="small text-muted" style="font-size: 0.8rem;">Hồ sơ lưu trữ hệ thống</span>
                        <span class="small fw-semibold text-dark">Danh bạ khách &rarr;</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Lượt đặt phòng -->
        <div class="col-sm-6 col-xl-3">
            <a asp-controller="Bookings" asp-action="Index" class="text-decoration-none">
                <div class="mono-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-uppercase text-secondary fw-semibold small" style="letter-spacing: 0.05em; font-size: 0.75rem;">Lượt Đặt Phòng</span>
                            <h2 class="display-6 fw-bold mb-0 text-dark mt-1">@Model.BookingCount</h2>
                        </div>
                        <div class="mono-stat-icon">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light-subtle">
                        <span class="small text-muted" style="font-size: 0.8rem;">Đơn đặt phòng lưu trú</span>
                        <span class="small fw-semibold text-dark">Quản lý đơn &rarr;</span>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- 2. Hàng Tác Vụ Nhanh (Đã bỏ icon sấm sét vàng, chuyển sang nút Trắng Đen tinh tế) -->
    <div class="mono-card p-4 mb-4">
        <h5 class="fw-bold text-dark mb-3" style="font-size: 1.05rem;">Thao Tác Nhanh Nghiệp Vụ Lễ Tân</h5>
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <a asp-controller="Bookings" asp-action="Create" class="mono-btn-action">
                    <i class="bi bi-calendar-plus"></i>
                    <span>Đặt Phòng Mới</span>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Guests" asp-action="Create" class="mono-btn-action">
                    <i class="bi bi-person-plus"></i>
                    <span>Thêm Khách Hàng</span>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="BookingHistory" asp-action="Index" class="mono-btn-action">
                    <i class="bi bi-search"></i>
                    <span>Tra Cứu Lịch Sử</span>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Invoice" asp-action="Index" class="mono-btn-action">
                    <i class="bi bi-receipt"></i>
                    <span>Tra Cứu Hóa Đơn</span>
                </a>
            </div>
        </div>
    </div>

    <!-- 3. Hàng Biểu Đồ: Xu hướng Doanh Thu & Top Chi Nhánh Doanh Thu Cao Nhất -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ Doanh Thu -->
        <div class="col-xl-7">
            <div class="mono-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3 pb-2 border-bottom border-light-subtle">
                    <div>
                        <h5 class="fw-bold text-dark mb-1" style="font-size: 1.05rem;">Xu Hướng Doanh Thu Hệ Thống</h5>
                        <p class="text-secondary small mb-0">Thống kê lũy kế theo chu kỳ tháng (Đơn vị: VNĐ)</p>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block" style="font-size: 0.75rem;">Tổng Doanh Thu Lũy Kế</span>
                        <span class="fw-bold text-dark fs-5">@Model.TotalAnnualRevenue.ToString("N0") đ</span>
                    </div>
                </div>
                <div style="height: 330px;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ Top Chi Nhánh -->
        <div class="col-xl-5">
            <div class="mono-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3 pb-2 border-bottom border-light-subtle">
                    <div>
                        <h5 class="fw-bold text-dark mb-1" style="font-size: 1.05rem;">Top Chi Nhánh Doanh Thu Cao Nhất</h5>
                        <p class="text-secondary small mb-0">Các cơ sở dẫn đầu về kết quả kinh doanh</p>
                    </div>
                    <div class="badge bg-dark text-white fw-normal px-2 py-1">Top Xếp Hạng</div>
                </div>
                <div style="height: 330px;">
                    <canvas id="branchesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Dữ liệu cho Biểu đồ Xu Hướng Doanh Thu (Monochrome Area Chart)
        var monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenues.Select(x => x.MonthName)));
        var monthlyRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenues.Select(x => (double)x.TotalRevenue)));

        var ctxRevenue = document.getElementById('revenueChart').getContext('2d');
        var revenueGradient = ctxRevenue.createLinearGradient(0, 0, 0, 300);
        revenueGradient.addColorStop(0, 'rgba(15, 23, 42, 0.35)');
        revenueGradient.addColorStop(1, 'rgba(15, 23, 42, 0.01)');

        new Chart(ctxRevenue, {
            type: 'line',
            data: {
                labels: monthlyLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: monthlyRevenues,
                    borderColor: '#0f172a',
                    borderWidth: 2.5,
                    backgroundColor: revenueGradient,
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: '#0f172a',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    pointHoverBackgroundColor: '#0f172a',
                    pointHoverBorderColor: '#ffffff',
                    pointHoverBorderWidth: 3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleColor: '#ffffff',
                        bodyColor: '#e2e8f0',
                        padding: 10,
                        cornerRadius: 8,
                        displayColors: false,
                        callbacks: {
                            label: function (context) {
                                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: '#64748b',
                            font: {
                                size: 11
                            }
                        }
                    },
                    y: {
                        grid: {
                            color: '#f1f5f9',
                            drawBorder: false
                        },
                        ticks: {
                            color: '#64748b',
                            font: {
                                size: 11
                            },
                            callback: function (value) {
                                if (value >= 1000000000) {
                                    return (value / 1000000000).toFixed(1) + ' tỷ';
                                } else if (value >= 1000000) {
                                    return (value / 1000000).toFixed(0) + ' tr';
                                } else if (value >= 1000) {
                                    return (value / 1000).toFixed(0) + ' k';
                                }
                                return value;
                            }
                        }
                    }
                }
            }
        });

        // 2. Dữ liệu cho Biểu đồ Top Chi Nhánh Doanh Thu Cao Nhất (Monochrome Horizontal Bar Chart)
        var branchLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopBranches.Select(x => x.HotelName.Replace("Grand Hotel ", ""))));
        var branchRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopBranches.Select(x => (double)x.TotalRevenue)));
        
        // Màu sắc giảm dần từ đen than sang xám đậm
        var branchColors = ['#0f172a', '#1e293b', '#334155', '#475569', '#64748b', '#94a3b8'];

        var ctxBranches = document.getElementById('branchesChart').getContext('2d');
        new Chart(ctxBranches, {
            type: 'bar',
            data: {
                labels: branchLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: branchRevenues,
                    backgroundColor: branchColors.slice(0, branchRevenues.length),
                    borderRadius: 6,
                    borderSkipped: false,
                    barThickness: 16
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleColor: '#ffffff',
                        bodyColor: '#e2e8f0',
                        padding: 10,
                        cornerRadius: 8,
                        displayColors: false,
                        callbacks: {
                            label: function (context) {
                                return 'Doanh thu: ' + new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.x);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            color: '#f1f5f9',
                            drawBorder: false
                        },
                        ticks: {
                            color: '#64748b',
                            font: {
                                size: 10
                            },
                            callback: function (value) {
                                if (value >= 1000000000) {
                                    return (value / 1000000000).toFixed(1) + ' tỷ';
                                } else if (value >= 1000000) {
                                    return (value / 1000000).toFixed(1) + ' tr';
                                } else if (value >= 1000) {
                                    return (value / 1000).toFixed(0) + ' k';
                                }
                                return value;
                            }
                        }
                    },
                    y: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: '#0f172a',
                            font: {
                                size: 11,
                                weight: '500'
                            }
                        }
                    }
                }
            }
        });
    });
</script>
}
