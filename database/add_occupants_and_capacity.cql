ALTER TABLE bookings_by_guest ADD num_occupants int;
ALTER TABLE bookings_by_guest ADD occupants_json text;
ALTER TABLE bookings_by_hotel_date ADD num_occupants int;
ALTER TABLE bookings_by_hotel_date ADD occupants_json text;

